#!/bin/sh
# 黄金定制 软路由 — 首次启动配置
# 由 uci-defaults 机制在固件第一次开机时自动执行一次

# 1. 主机名 / 访问控制默认值
uci set system.@system[0].hostname='golden'
uci set system.@system[0].golden_admin_user='root'
uci set system.@system[0].golden_guest_user='guest'
uci set system.@system[0].golden_login_lock='5'
uci set system.@system[0].golden_session_timeout='15'
# 登录爆破内核封禁时长（秒）：连续输错 golden_login_lock 次后来源 IP 的所有访问被 DROP。
# 【v1.1.1 加固】默认 0 = 只做应用层锁定（Web 锁 15 分钟），不下发内核封禁。
# 原因：内核封禁会把来源 IP 的所有端口 DROP，曾造成“服务在跑但页面打不开”的假故障，
#       且封禁表在内存、重启服务不清、只有重启设备才解——对开箱即用风险大于收益。
# 需要更强防护的用户可在 WEB 后台把该项调回（如 600 秒）。
uci set system.@system[0].golden_ban_seconds='0'
uci commit system

# 2. 设置 root 默认密码为 admin（登录后请务必在 WEB 访问设置里修改）
#    使用 OpenWrt 标准 passwd 命令设置（golden-api 登录按 /etc/shadow 校验）
(echo 'admin'; sleep 1; echo 'admin') | passwd root 2>/dev/null
# 兜底：若 passwd 交互异常导致 root 在 shadow 中仍为锁定态，用 cryptpw 生成 hash 直写
if ! grep -Eq '^root:\$[156]\$' /etc/shadow 2>/dev/null; then
  ROOT_HASH=$(echo 'admin' | busybox cryptpw -a sha512 2>/dev/null)
  if [ -n "$ROOT_HASH" ]; then
    sed -i "s|^root:[^:]*:|root:${ROOT_HASH}:|" /etc/shadow 2>/dev/null
  fi
fi

# 2.1 创建 guest（只读访客）系统账户；shell 用 /bin/false 禁止 SSH 登录
#     默认密码 guest，只读权限，仅用于 WEB 登录查看
if ! grep -q '^guest:' /etc/shadow 2>/dev/null; then
  adduser -D -H -s /bin/false guest 2>/dev/null
  (echo 'guest'; sleep 1; echo 'guest') | passwd guest 2>/dev/null
fi
# 首次登录强制修改默认密码标志（root/admin 登录后必须改密）
uci set system.@system[0].golden_first_login='1'

# 3. 确保 uhttpd 支持 CGI（/cgi-bin/ 接口必需）
uci set uhttpd.main.cgi_prefix='/cgi-bin'
uci set uhttpd.main.lua_prefix='/cgi-bin/luci'

# 3.1 HTTPS / 证书处理（2026-09-03 重写，纠正历史误判）
#     【事实】OpenWrt 23.05 中 px5g 并没有“改名”：
#              px5g-mbedtls（动态）与 px5g-standalone（静态）是同一程序的两个变体，
#              可执行文件都安装为 /usr/sbin/px5g（PROVIDES:=px5g），uhttpd.init 查找的正是该路径。
#              所以固件里存在任一变体即可，脚本中应调用的是 px5g 命令，不是 px5g-standalone。
#     【原则】uhttpd 是否启用 HTTPS 取决于是否存在 SSL 后端 /lib/libustream-ssl.so：
#             无 SSL 后端 → https 相关配置无意义，直接移除，保证 http 80 一定可用；
#             有 SSL 后端 → 用 px5g 生成自签证书；仍失败则移除 https 监听兜底。
if [ -f /lib/libustream-ssl.so ]; then
  uci set uhttpd.main.cert='/etc/uhttpd.crt'
  uci set uhttpd.main.key='/etc/uhttpd.key'
  uci commit uhttpd
  if [ ! -s /etc/uhttpd.crt ] || [ ! -s /etc/uhttpd.key ]; then
    if command -v px5g >/dev/null 2>&1; then
      # 关键：-der 参数不可省略！官方 uhttpd.init 生成证书带 -der（输出 DER 格式）；
      # 缺 -der 会生成 uhttpd 无法加载的证书 → 启动即崩 "Failed to load certificate/key files"
      # → procd crash loop → 连 80 端口一起挂（v1.1.1 现网事故根因）
      px5g selfsigned -der -days 1825 -newkey rsa:2048 -keyout /etc/uhttpd.key -out /etc/uhttpd.crt -subj /CN=golden 2>/dev/null || true
    fi
  fi
  if [ ! -s /etc/uhttpd.crt ] || [ ! -s /etc/uhttpd.key ]; then
    uci -q delete uhttpd.main.listen_https
    uci commit uhttpd
  fi
else
  uci -q delete uhttpd.main.listen_https
  uci -q delete uhttpd.main.cert
  uci -q delete uhttpd.main.key
  uci commit uhttpd
fi

# 3.2 确保 HTTP 80 监听存在（防 uhttpd 配置被其它包改写后丢失）
uci -q del_list uhttpd.main.listen_http='0.0.0.0:80'
uci -q add_list uhttpd.main.listen_http='0.0.0.0:80'
uci commit uhttpd

# 3.3 确保 uhttpd 开机自启并立即启动（修复：部分镜像首启 uhttpd 未自动运行导致后台打不开）
#      uci-defaults 在 boot 早期执行，此时 S50uhttpd 尚未运行，这里直接 start 拉起一次；
#      之后 rc.d 正常启动流程会再次确认实例，procd 幂等，无副作用。
/etc/init.d/uhttpd enable 2>/dev/null
/etc/init.d/uhttpd start 2>/dev/null || true

# 3.3 创建 golden 配置文件（UCI 段由后端运行时写入）
if [ ! -f /etc/config/golden ]; then
  echo '# 黄金定制 运行时配置（由后端 golden-api 写入）' > /etc/config/golden
fi
# 私接 DHCP 探测默认值（默认不拦截，仅记录告警）
uci set golden.dhcpdetect='dhcpdetect'
uci set golden.dhcpdetect.interval='30'
uci set golden.dhcpdetect.intercept='0'
uci set golden.dhcpdetect.alert='日志'
uci commit golden
# 启用私接 DHCP 探测守护（开机自动启动）
/etc/init.d/golden-dhcpdetect enable 2>/dev/null
/etc/init.d/golden-dhcpdetect start 2>/dev/null

# 3.4 批3 功能默认值（域名过滤 / 应用限制 / 端口触发 / 镜像 / 电信网通 / ARP 防御）
uci set golden.domainfilter='domainfilter'
uci set golden.domainfilter.mode='disable'
uci set golden.domainfilter.audit='0'
uci set golden.domainfilter.rebind_protect='1'
uci set golden.applimit='applimit'
uci set golden.applimit.enabled='0'
uci set golden.porttrigger='porttrigger'
uci set golden.porttrigger.enabled='0'
uci set golden.mirror='mirror'
uci set golden.mirror.enabled='0'
uci set golden.mirror.dir='all'
uci set golden.mirror.mode='host'
uci set golden.mirror.ip=''
# ARP 防御：默认关闭（绑定表外拦截影响上网，需用户显式开启）
uci set golden.arpdefense='arpdefense'
uci set golden.arpdefense.enabled='0'
uci set golden.arpdefense.fakegateway='0'
uci set golden.arpdefense.fakeinterval='200'
uci set golden.arpdefense.illegalgateway='0'
uci set golden.arpdefense.illegalinterval='10'
uci set golden.arpdefense.level='中'
# 批4 WAN 隐身 + 端口扫描检测默认值（默认关闭，用户显式开启）
uci set golden.wanharden='wanharden'
uci set golden.wanharden.ping_wan='0'
uci set golden.wanharden.ttl_drop='0'
uci set golden.wanharden.scan_enable='0'
uci set golden.wanharden.scan_hitcount='30'
uci set golden.wanharden.scan_seconds='60'
# 批5 上网行为审计默认值（默认关闭）+ 一键封禁黑名单（空列表，由运行时写入）
uci set golden.dnsaudit='dnsaudit'
uci set golden.dnsaudit.enabled='0'
uci set golden.blocklist='blocklist'
uci commit golden
# 批3 规则聚合启动（开机自动应用已保存的规则）
/etc/init.d/golden-fw enable 2>/dev/null
/etc/init.d/golden-fw start 2>/dev/null

# 4. 确保 LAN 口 IP 为 192.168.1.1（默认即是，显式保证）
uci set network.lan.ipaddr='192.168.1.1'
uci set network.lan.netmask='255.255.255.0'
uci commit network

# 5. DHCP 默认关闭（用户可在 网络设置-DHCP设置 中手动开启）
uci set dhcp.lan.ignore='1'
uci commit dhcp

# 6. SSH 默认开启（保底排障通道：Web 万一异常时仍可 SSH 登录定位）。
#    用户可在 访问设置-SSH访问设置 中随时关闭。
uci set dropbear.@dropbear[0].enable='1'
uci set dropbear.@dropbear[0].Port='22'
uci set dropbear.@dropbear[0].PasswordAuth='on'
uci set dropbear.@dropbear[0].RootPasswordAuth='on'
uci commit dropbear
/etc/init.d/dropbear enable 2>/dev/null
/etc/init.d/dropbear start 2>/dev/null || true

# 7. 设置首页跳转：访问 192.168.1.1 自动进入黄金定制后台
mkdir -p /www
cat > /www/index.html << 'HTML'
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta http-equiv="refresh" content="0;url=/golden/">
<title>黄金定制 软路由</title>
</head>
<body style="background:#0f172a;color:#e2e8f0;font-family:sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;">
正在进入 黄金定制 软路由管理后台... <a href="/golden/" style="color:#60a5fa">点击进入</a>
</body>
</html>
HTML

exit 0
