-- ==================== 主逻辑 ====================
local ok, payload
ok, payload = pcall(function()
  local action = args.action or 'all'

  -- 认证接口（无需登录）
  if action == 'auth' then
    local an = args.name or ''
    if an == 'login' then
      local method = os.getenv('REQUEST_METHOD') or 'GET'
      local body = ''
      if method == 'POST' then
        local cl = tonumber(os.getenv('CONTENT_LENGTH') or '0') or 0
        if cl > 0 and cl < 1048576 then body = io.read(cl) end
      end
      local raw = body
      if raw == '' and args.json then raw = urldecode(args.json) end
      local data = {}
      if raw ~= '' then
        local parsed = json_parse(raw)
        if type(parsed) == 'table' then data = parsed end
      end
      return authLogin(data)
    elseif an == 'check' then
      return authCheck(headerToken() ~= '' and headerToken() or args.token or '')
    elseif an == 'logout' then
      return authLogout(headerToken() ~= '' and headerToken() or args.token or '')
    end
    error('未知认证操作: ' .. an)
  end

  -- 写操作：先解析 body，再校验 token + admin 权限（CSRF 防护 + guest 只读）
  if action == 'set' or action == 'write' then
    local raw = readPostBody(1048576)
    if raw == '' and args.json then raw = urldecode(args.json) end
    local data = {}
    if raw ~= '' then
      local parsed = json_parse(raw)
      if type(parsed) == 'table' then data = parsed end
    end
    local sess = checkSession(headerToken() ~= '' and headerToken() or data.token or '')
    if not sess then error({ code = 401, msg = '未登录或会话已过期' }) end
    if sess.role ~= 'admin' then error({ code = 403, msg = '访客账号为只读权限，不能修改配置' }) end
    local domain = data.domain or args.domain
    local config = data.config or {}
    local fn = SET_DISPATCH[domain]
    if not fn then error('未知配置域: ' .. tostring(domain)) end
    fn(config)
    return { saved = true, domain = domain }
  end

  -- 其余接口：必须登录（token 一律从请求头获取）
  local sess = checkSession(headerToken())
  if not sess then error({ code = 401, msg = '未登录或会话已过期' }) end

  if action == 'run' then
    if sess.role ~= 'admin' then error({ code = 403, msg = '访客账号为只读权限，不能执行操作' }) end
    local name = args.name or ''
    if name == 'ping' then return runPing(args.host or '') end
    if name == 'login-banlist' then
      -- 当前被 iptables 封禁的登录爆破来源（读 recent 内核表）
      local banned = {}
      local raw = readFile('/proc/net/xt_recent/glb')
      for ln in raw:gmatch('[^\n]+') do
        local ip = ln:match('src=(%d+%.%d+%.%d+%.%d+)')
        if ip then banned[#banned + 1] = ip end
      end
      return { banned = banned }
    end
    if name == 'login-unban' then
      -- 手动解封：移除 recent 标记 + 清除应用层失败计数
      requirePost()
      local ip = sanitize(args.ip or '', '^%d+%.%d+%.%d+%.%d+$')
      if ip == '' then error('请输入要解封的 IP 地址') end
      os.execute("iptables -D golden_login -m recent --name glb --set -j DROP -s " .. ip .. " 2>/dev/null")
      -- xt_recent 解封：写 -IP 到内核表（sed -i 对 /proc 无效）
      os.execute("echo '-" .. ip .. "' > /proc/net/xt_recent/glb 2>/dev/null")
      os.execute('rm -f ' .. LOCK_DIR .. '/' .. ip)
      return { unbanned = ip }
    end
    if name == 'reboot' then requirePost() os.execute('/sbin/reboot &') return { rebooted = true } end
    if name == 'poweroff' then requirePost() os.execute('/sbin/poweroff &') return { poweredOff = true } end
    if name == 'reset' then
      requirePost()
      os.execute('/sbin/firstboot -y >/dev/null 2>&1; /sbin/reboot &')
      return { reset = true }
    end
    if name == 'restartservice' then
      requirePost()
      local svc = sanitize(args.service, '^[%w_%-]+$')
      os.execute('/etc/init.d/' .. svc .. ' restart 2>/dev/null &')
      return { restarted = svc }
    end
    if name == 'arplog-clear' then
      requirePost()
      os.execute('rm -f /tmp/golden_arplog')
      return { cleared = true }
    end
    if name == 'dnsblock-clear' then
      -- 清空域名拦截审计日志（批4）
      requirePost()
      os.execute('rm -f /tmp/golden_dnsblock.log')
      return { cleared = true }
    end
    if name == 'dnsaudit-clear' then
      -- 清空上网行为审计日志（批5）
      requirePost()
      os.execute('rm -f /tmp/golden_dnsaudit.log')
      return { cleared = true }
    end
    if name == 'block-ip' then
      -- 一键封禁：UCI 持久化 + iptables golden_block 链 DROP 该 IP 全部流量
      requirePost()
      local ip = sanitize(args.ip or '', '^%d+%.%d+%.%d+%.%d+$')
      if ip == '' then error('请输入要封禁的 IP 地址') end
      local exists = false
      for _, x in ipairs(getBlockList().banned) do if x == ip then exists = true break end end
      if not exists then
        os.execute("uci -q delete golden.blocklist 2>/dev/null; uci set golden.blocklist=blocklist; uci add_list golden.blocklist.ip='" .. ip .. "'; uci commit golden")
      end
      applyBlockIp(ip, true)
      os.execute("logger -t golden-sec 'block-ip " .. ip .. "' 2>/dev/null")
      return { blocked = ip }
    end
    if name == 'unblock-ip' then
      -- 解除封禁：从 UCI 列表移除 + 删除 iptables 规则
      requirePost()
      local ip = sanitize(args.ip or '', '^%d+%.%d+%.%d+%.%d+$')
      if ip == '' then error('请输入要解封的 IP 地址') end
      os.execute("uci -q del_list golden.blocklist.ip='" .. ip .. "'; uci commit golden")
      applyBlockIp(ip, false)
      os.execute("logger -t golden-sec 'unblock-ip " .. ip .. "' 2>/dev/null")
      return { unblocked = ip }
    end
    if name == 'backup' then
      -- 系统参数备份：打包 /etc/config + /etc/golden → tar.gz → 纯 Lua base64
      requirePost()
      os.execute('tar czf /tmp/golden-backup.tar.gz /etc/config /etc/golden 2>/dev/null')
      -- busybox 无 stat applet，改用 wc -c 取文件大小
      local size = tonumber(sh('wc -c < /tmp/golden-backup.tar.gz') or '0') or 0
      if size == 0 then error('备份失败：未找到可备份的配置') end
      local b64 = b64encode(readFile('/tmp/golden-backup.tar.gz'))
      return { filename = 'golden-backup-' .. os.date('%Y%m%d-%H%M%S') .. '.tar.gz', size = size, b64 = b64 }
    end
    if name == 'restore' then
      -- 恢复参数：body = JSON {filename, b64}，恢复前自动备份当前配置
      local method = os.getenv('REQUEST_METHOD') or 'GET'
      if method ~= 'POST' then error('请通过 POST 上传备份文件') end
      local cl = tonumber(os.getenv('CONTENT_LENGTH') or '0') or 0
      if cl <= 0 or cl > 33554432 then error('备份文件大小无效（最大 32MB）') end
      local raw = io.read(cl) or ''
      local data = {}
      local parsed = json_parse(raw)
      if type(parsed) == 'table' then data = parsed end
      local b64 = tostring(data.b64 or ''):gsub('%s+', '')
      if b64 == '' then error('未收到备份文件内容') end
      -- 纯 Lua base64 解码后直接写二进制（busybox 默认无 base64 applet）
      local bin = b64decode(b64)
      if #bin < 100 then error('备份文件无效或已损坏') end
      local bf = io.open('/tmp/golden-restore.tar.gz', 'wb')
      if not bf then error('无法写入临时文件') end
      bf:write(bin)
      bf:close()
      -- 安全校验：tar 内容必须限定在 etc/config 与 etc/golden
      local listing = sh("tar tzf /tmp/golden-restore.tar.gz 2>/dev/null")
      if listing == '' then error('备份文件无效或已损坏') end
      for line in listing:gmatch('[^\n]+') do
        if line:match('^/') or line:match('%.%./') then error('备份文件包含非法路径') end
        if not (line:match('^etc/config/') or line:match('^etc/golden/')) then
          error('备份文件包含未知路径: ' .. line)
        end
      end
      -- 恢复前自动备份当前配置
      os.execute('tar czf /tmp/golden-pre-restore-' .. os.date('%Y%m%d-%H%M%S') .. '.tar.gz /etc/config /etc/golden 2>/dev/null')
      os.execute('tar xzf /tmp/golden-restore.tar.gz -C / 2>/dev/null')
      os.execute('/etc/init.d/network reload 2>/dev/null &')
      os.execute('/etc/init.d/dnsmasq restart 2>/dev/null &')
      os.execute('/etc/init.d/firewall reload 2>/dev/null &')
      return { restored = true, preBackup = '/tmp/golden-pre-restore-*.tar.gz' }
    end
    if name == 'upgrade' then
      -- 固件升级第一步：上传原始 .bin（body=二进制）→ sysupgrade -T 完整性校验
      local method = os.getenv('REQUEST_METHOD') or 'GET'
      if method ~= 'POST' then error('请通过 POST 上传固件文件') end
      local cl = tonumber(os.getenv('CONTENT_LENGTH') or '0') or 0
      if cl < 1048576 or cl > 67108864 then error('固件大小无效（需 1MB-64MB）') end
      local f = io.open('/tmp/golden-fw.bin', 'wb')
      local remain = cl
      while remain > 0 do
        local chunk = io.read(math.min(remain, 65536))
        if not chunk then break end
        f:write(chunk)
        remain = remain - #chunk
      end
      f:close()
      if remain > 0 then error('固件上传不完整，请重试') end
      local rc = os.execute('sysupgrade -T /tmp/golden-fw.bin >/tmp/golden-upgrade-check.log 2>&1')
      if rc ~= 0 then
        local msg = readFile('/tmp/golden-upgrade-check.log'):gsub('[\r\n]+', ' ')
        error('固件校验失败，已取消升级' .. (msg ~= '' and ('：' .. msg) or ''))
      end
      local size = tonumber(sh('wc -c < /tmp/golden-fw.bin') or '0') or 0
      local md5 = sh("md5sum /tmp/golden-fw.bin | awk '{print $1}'")
      return { verified = true, size = size, md5 = md5 }
    end
    if name == 'upgrade-confirm' then
      -- 固件升级第二步：用户输入 yes 确认后执行（保留配置）
      requirePost()
      local f = io.open('/tmp/golden-fw.bin', 'r')
      if not f then error('固件文件不存在，请重新上传') end
      f:close()
      os.execute('nohup sysupgrade /tmp/golden-fw.bin >/dev/null 2>&1 &')
      return { rebooting = true }
    end
    if name == 'ctcnc-default' then
      -- 使用内置精简默认地址表
      requirePost()
      local key = sanitize(args.key or '', '^[%w]+$')
      if not IPLIB_KEYS[key] then error('未知地址库: ' .. tostring(args.key)) end
      local lines = DEFAULT_IPLIB[key]
      if not lines then error('该地址库无内置默认表') end
      local count = writeIpLib(key, lines)
      uciSet('golden', 'ctcnc_' .. key, 'enabled', '1')
      uciCommit('golden')
      os.execute('sh /etc/golden/ctcnc.sh restart 2>/dev/null &')
      return { imported = count, key = key }
    end
    if name == 'ctcnc-download' then
      -- 联网下载完整地址表（wget，带超时）
      requirePost()
      local key = sanitize(args.key or '', '^[%w]+$')
      local url = IPLIB_URL[key]
      if not url then error('该地址库暂不支持在线下载') end
      os.execute('wget -q -T 20 -O /tmp/golden-ip.txt "' .. url .. '" 2>/dev/null')
      local raw = readFile('/tmp/golden-ip.txt')
      if raw == '' then error('下载失败：请检查网络连通后重试') end
      local lines = {}
      for ln in raw:gmatch('[^\n]+') do
        local cidr = ln:gsub('%s+', ''):gsub('\r', '')
        if cidr:match('^%d+%.%d+%.%d+%.%d+/%d+$') then lines[#lines + 1] = cidr end
      end
      if #lines == 0 then error('下载内容无效（未解析到 IP 段）') end
      local count = writeIpLib(key, lines)
      uciSet('golden', 'ctcnc_' .. key, 'enabled', '1')
      uciCommit('golden')
      os.execute('sh /etc/golden/ctcnc.sh restart 2>/dev/null &')
      return { imported = count, key = key }
    end
    if name == 'ctcnc-import' then
      -- 上传地址文件：POST body = JSON {key, lines[]}
      local method = os.getenv('REQUEST_METHOD') or 'GET'
      if method ~= 'POST' then error('请通过 POST 上传地址文件') end
      local cl = tonumber(os.getenv('CONTENT_LENGTH') or '0') or 0
      if cl <= 0 or cl > 2097152 then error('地址文件过大（最大 2MB）') end
      local raw = io.read(cl) or ''
      local data = {}
      local parsed = json_parse(raw)
      if type(parsed) == 'table' then data = parsed end
      local key = sanitize(tostring(data.key or ''), '^[%w]+$')
      if not IPLIB_KEYS[key] then error('未知地址库: ' .. tostring(data.key)) end
      if type(data.lines) ~= 'table' then error('缺少地址段内容') end
      local count = writeIpLib(key, data.lines)
      uciSet('golden', 'ctcnc_' .. key, 'enabled', '1')
      uciCommit('golden')
      os.execute('sh /etc/golden/ctcnc.sh restart 2>/dev/null &')
      return { imported = count, key = key }
    end
    error('未知操作: ' .. name)
  elseif action == 'get' or action == 'read' then
    local name = args.name or 'all'
    local fn = GET_MAP[name]
    if not fn then error('未知读取: ' .. name) end
    return fn()
  elseif GET_MAP[action] then
    return GET_MAP[action]()
  else
    error('未知接口: ' .. action)
  end
end)

io.write('Content-Type: application/json; charset=utf-8\r\n\r\n')
if ok then
  io.write(jenc({ ok = true, error = '', payload = payload }))
else
  local code = 500
  local msg = tostring(payload)
  if type(payload) == 'table' then
    code = payload.code or 500
    msg = payload.msg or '未知错误'
  end
  io.write(jenc({ ok = false, code = code, error = msg, payload = {} }))
end
