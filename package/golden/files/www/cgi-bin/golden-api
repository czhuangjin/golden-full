local function saveLb(cfg)
  -- 清理旧的 golden 配置
  os.execute("uci delete mwan3.golden_policy 2>/dev/null; uci delete mwan3.golden_rule 2>/dev/null")
  local members = {}
  local mode = sanitize(cfg.mode or 'smart', '^[%w_]+$')
  local lines = cfg.lines or {}
  for i, line in ipairs(lines) do
    local mn = 'golden_m' .. i
    os.execute("uci delete mwan3." .. mn .. " 2>/dev/null")
    uciSet('mwan3', mn, 'interface', sanitize(line.id, '^[%w_]+$'))
    uciSet('mwan3', mn, 'weight', tonumber(line.weight) or 1)
    local active = (line.active == true or line.active == '1' or line.active == 1)
    if active then
      uciSet('mwan3', mn, 'enabled', '1')
      uciSet('mwan3', mn, 'track_ip', '223.5.5.5')
      uciSet('mwan3', mn, 'interval', tonumber(line.interval) or 3)
      uciSet('mwan3', mn, 'count', tonumber(line.times) or 3)
      uciSet('mwan3', mn, 'timeout', '2')
      uciSet('mwan3', mn, 'down', '2')
      uciSet('mwan3', mn, 'up', '3')
    else
      uciSet('mwan3', mn, 'enabled', '0')
    end
    members[#members + 1] = mn
  end
  uciSet('mwan3', 'golden_policy', 'label', 'golden')
  for _, mn in ipairs(members) do uciAddList('mwan3', 'golden_policy', 'use_member', mn) end
  uciSet('mwan3', 'golden_rule', 'label', 'golden_all')
  uciSet('mwan3', 'golden_rule', 'policy', 'golden_policy')
  uciCommit('mwan3')
  os.execute('/etc/init.d/mwan3 restart 2>/dev/null &')
  return true
end
