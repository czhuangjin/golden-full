-- ==================== 写入：防火墙 ====================
local function saveFirewall(cfg)
  cfg = cfg or {}
  -- 连接数上限
  if cfg.connMax and tonumber(cfg.connMax) then
    os.execute("sysctl -w net.netfilter.nf_conntrack_max=" .. tonumber(cfg.connMax) .. " 2>/dev/null")
  end
  -- 端口映射（先清空 golden 规则）
  os.execute("uci show firewall | grep -E 'firewall%.golden' | cut -d. -f2 | cut -d= -f1 | while read n; do uci delete firewall.$n; done 2>/dev/null")
  local maps = cfg.portmaps or {}
  for i, m in ipairs(maps) do
    local rn = 'golden_rd' .. i
    uciSet('firewall', rn, 'name', rn)
    uciSet('firewall', rn, 'src', 'wan')
    uciSet('firewall', rn, 'proto', 'tcp udp')
    uciSet('firewall', rn, 'src_dport', sanitize(m.external, '^[%d%-]+$'))
    uciSet('firewall', rn, 'dest_ip', sanitize(m.internalIp, IPPAT))
    uciSet('firewall', rn, 'dest_port', sanitize(m.internal, '^[%d]+$'))
    uciSet('firewall', rn, 'target', 'DNAT')
    uciSet('firewall', rn, 'family', 'ipv4')
  end
  -- DMZ
  if cfg.dmz and cfg.dmz.enable and cfg.dmz.ip and cfg.dmz.ip:match(IPPAT) then
    uciSet('firewall', 'golden_dmz', 'name', 'golden_dmz')
    uciSet('firewall', 'golden_dmz', 'src', 'wan')
    uciSet('firewall', 'golden_dmz', 'dest_ip', cfg.dmz.ip)
    uciSet('firewall', 'golden_dmz', 'target', 'DNAT')
    uciSet('firewall', 'golden_dmz', 'family', 'ipv4')
  else
    os.execute("uci delete firewall.golden_dmz 2>/dev/null")
  end
  -- UPnP
  if cfg.upnp ~= nil then
    uciSet('upnpd', 'config', 'enabled', (cfg.upnp == true or cfg.upnp == '1' or cfg.upnp == 1) and '1' or '0')
    uciCommit('upnpd')
  end
  -- UPnP 安全加固（批4）：secure_mode + 仅允许映射非特权端口（防内网恶意软件向公网开放 <1024 端口）
  if cfg.upnpSecure ~= nil then
    local sec = (cfg.upnpSecure == true or cfg.upnpSecure == '1' or cfg.upnpSecure == 1)
    uciSet('upnpd', 'config', 'secure_mode', sec and '1' or '0')
    os.execute("uci -q delete upnpd.config.acl_rule 2>/dev/null")
    if sec then
      os.execute("uci add_list upnpd.config.acl_rule='deny 0-1023 0.0.0.0/0 0-65535' 2>/dev/null")
    end
    uciCommit('upnpd')
  end
  uciCommit('firewall')
  os.execute('/etc/init.d/firewall reload 2>/dev/null & /etc/init.d/miniupnpd restart 2>/dev/null &')
  return true
end

-- ==================== 写入：ARP 绑定 / 行为管理 / 策略路由 / 高级 ====================
local function saveArp(cfg)
  local list = cfg
  if type(list) ~= 'table' then list = {} end
  local f = io.open('/etc/ethers', 'w')
  for _, b in ipairs(list) do
    if b.mac and b.mac:match(MACPAT) and b.ip and b.ip:match(IPPAT) then
      f:write(b.mac .. '\t' .. b.ip .. '\n')
    end
  end
  f:close()
  os.execute("uci show dhcp | grep -E 'dhcp%.golden_lease' | cut -d. -f2 | cut -d= -f1 | while read n; do uci delete dhcp.$n; done 2>/dev/null")
  for i, b in ipairs(list) do
    if b.mac and b.mac:match(MACPAT) and b.ip and b.ip:match(IPPAT) then
      uciSet('dhcp', 'golden_lease' .. i, 'mac', b.mac)
      uciSet('dhcp', 'golden_lease' .. i, 'ip', b.ip)
      uciSet('dhcp', 'golden_lease' .. i, 'name', b.name or '')
    end
  end
  uciCommit('dhcp')
  os.execute('/etc/init.d/dnsmasq reload 2>/dev/null &')
  return true
end
local function saveBehavior(cfg)
  cfg = cfg or {}
  -- IP 段限制：防火墙 src 规则
  os.execute("uci show firewall | grep -E 'firewall%.golden_ip' | cut -d. -f2 | cut -d= -f1 | while read n; do uci delete firewall.$n; done 2>/dev/null")
  local rules = cfg.ipLimit or {}
  local enable = (cfg.enable == true or cfg.enable == '1' or cfg.enable == 1)
  if enable then
    local i = 0
    for _, r in ipairs(rules) do
      if r.ip and (r.ip:match(IPPAT) or r.ip:find('*') or r.ip:find('-')) then
        i = i + 1
        local rn = 'golden_ip' .. i
        uciSet('firewall', rn, 'name', rn)
        uciSet('firewall', rn, 'src', 'lan')
        uciSet('firewall', rn, 'src_ip', r.ip)
        uciSet('firewall', rn, 'dest', 'wan')
        uciSet('firewall', rn, 'proto', 'all')
        uciSet('firewall', rn, 'target', 'REJECT')
        uciSet('firewall', rn, 'family', 'ipv4')
      end
    end
  end
  uciCommit('firewall')
  os.execute('/etc/init.d/firewall reload 2>/dev/null &')
  return true
end
local function savePolicy(cfg)
  -- 策略路由：写 mwan3 规则（目标 IP 走指定线路）
  cfg = cfg or {}
  os.execute("uci show mwan3 | grep -E 'mwan3%.golden_pr' | cut -d. -f2 | cut -d= -f1 | while read n; do uci delete mwan3.$n; done 2>/dev/null")
  local routes = cfg.routes or {}
  local i = 0
  for _, r in ipairs(routes) do
    if r.dest and r.interface then
      i = i + 1
      local rn = 'golden_pr' .. i
      uciSet('mwan3', rn, 'label', rn)
      uciSet('mwan3', rn, 'src_ip', r.src or '0.0.0.0/0')
      uciSet('mwan3', rn, 'dest_ip', r.dest)
      uciSet('mwan3', rn, 'proto', 'all')
      -- mwan3 规则的正确字段是 use_policy（policy 是无效选项，写了会校验失败不生效）
      uciSet('mwan3', rn, 'use_policy', r.interface)
    end
  end
  uciCommit('mwan3')
  os.execute('/etc/init.d/mwan3 restart 2>/dev/null &')
  return true
end
local function setPassword(user, pass)
  if not user or user == '' or not pass or pass == '' then return end
  -- OpenWrt 使用 shadow 系统账户；root 是默认管理员。
  -- 若用户名不是 root，则通过 uci 保存别名并在登录时做映射；
  -- 这里先保证 root 密码被设置，再保存别名。
  local safe = tostring(pass):gsub("'", "'\\''")
  os.execute("(echo '" .. safe .. "'; echo '" .. safe .. "') | passwd root 2>/dev/null")
  -- 同步应急通道：固件无 cryptpw 时 Web 校验依赖 golden_web_pass，改密后必须同步，否则新密码永远登录失败
  uciSet('system', '@system[0]', 'golden_web_pass', tostring(pass))
  uciCommit('system')
  if user ~= 'root' then
    uciSet('system', '@system[0]', 'golden_admin_user', user)
    uciCommit('system')
  end
end

-- 设置 guest（只读访客）密码；账户不存在（未初始化）时静默跳过
local function setGuestPassword(pass)
  if not pass or pass == '' then return end
  local cnt = tonumber(sh("grep -c '^guest:' /etc/shadow 2>/dev/null") or '0') or 0
  if cnt <= 0 then return end
  local safe = tostring(pass):gsub("'", "'\\''")
  os.execute("(echo '" .. safe .. "'; echo '" .. safe .. "') | passwd guest 2>/dev/null")
end

local function saveAdmin(cfg)
  cfg = cfg or {}
  local user = cfg.newUser or cfg.oldUser or 'root'
  local pass = cfg.newPass
  local confirm = cfg.newPassConfirm
  if not pass or pass == '' then error('新密码不能为空') end
  if pass ~= confirm then error('两次输入的新密码不一致') end
  -- 用户名修改：保存别名；密码修改：写入 root（OpenWrt 实际管理账户）
  setPassword(user, pass)
  if cfg.newUser and cfg.newUser ~= '' then
    uciSet('system', '@system[0]', 'golden_admin_user', cfg.newUser)
    uciCommit('system')
  end
  return true
end

local function saveAdvanced(cfg)
  cfg = cfg or {}
  -- MAC 克隆
  if cfg.macClone and cfg.macClone:match(MACPAT) then
    uciSet('network', 'wan', 'macaddr', cfg.macClone)
    uciCommit('network')
    os.execute('/etc/init.d/network reload 2>/dev/null &')
  end
  -- Web 访问设置
  if cfg.httpPort and tonumber(cfg.httpPort) then
    uciSet('uhttpd', 'main', 'listen_http', '0.0.0.0:' .. tonumber(cfg.httpPort))
  end
  if cfg.remoteAccess then
    if cfg.remotePort and tonumber(cfg.remotePort) then
      -- 远程管理强制 HTTPS（绝不开放明文 HTTP 到 WAN）
      uciSet('uhttpd', 'main', 'listen_https', '0.0.0.0:' .. tonumber(cfg.remotePort))
      -- 清理旧的远程放通规则
      os.execute("for i in $(seq 1 20); do uci -q delete firewall.golden_remote_$i 2>/dev/null; done")
      -- 源 IP 白名单：留空 = 不创建任何放通规则 = 外网无法访问
      local allow = (cfg.remoteAllow or ''):gsub('%s', '')
      local n = 0
      for ip in allow:gmatch('[^,]+') do
        if ip:match('^[%d%.]+$') or ip:match('^[%d%.]+/[%d]+$') then
          n = n + 1
          local rn = (n == 1) and 'golden_remote' or ('golden_remote_' .. n)
          uciSet('firewall', rn, 'name', rn)
          uciSet('firewall', rn, 'src', 'wan')
          uciSet('firewall', rn, 'proto', 'tcp')
          uciSet('firewall', rn, 'src_ip', ip)
          uciSet('firewall', rn, 'src_dport', tostring(cfg.remotePort))
          uciSet('firewall', rn, 'target', 'ACCEPT')
          uciSet('firewall', rn, 'family', 'ipv4')
        end
      end
      if n == 0 then
        os.execute("uci -q delete firewall.golden_remote 2>/dev/null")
      end
      uciSet('system', '@system[0]', 'golden_remote_allow', allow)
      uciCommit('firewall')
      uciCommit('system')
      os.execute('/etc/init.d/firewall reload 2>/dev/null &')
    end
  else
    os.execute("uci -q delete uhttpd.main.listen_https 2>/dev/null; uci -q delete firewall.golden_remote 2>/dev/null; for i in $(seq 1 20); do uci -q delete firewall.golden_remote_$i 2>/dev/null; done")
    uciCommit('uhttpd')
    uciCommit('firewall')
    os.execute('/etc/init.d/firewall reload 2>/dev/null &')
  end
  if cfg.adminUser and cfg.adminUser ~= '' then
    uciSet('system', '@system[0]', 'golden_admin_user', cfg.adminUser)
  end
  if cfg.guestUser and cfg.guestUser ~= '' then
    uciSet('system', '@system[0]', 'golden_guest_user', cfg.guestUser)
  end
  if cfg.loginLock and tonumber(cfg.loginLock) then
    uciSet('system', '@system[0]', 'golden_login_lock', tostring(cfg.loginLock))
  end
  if cfg.sessionTimeout and tonumber(cfg.sessionTimeout) then
    uciSet('system', '@system[0]', 'golden_session_timeout', tostring(cfg.sessionTimeout))
  end
  if cfg.adminPass and cfg.adminPass ~= '' then
    setPassword(cfg.adminUser or 'root', cfg.adminPass)
    -- 首次登录强制改密完成后清除标志
    uciSet('system', '@system[0]', 'golden_first_login', '0')
    uciCommit('system')
  end
  if cfg.guestPass and cfg.guestPass ~= '' then
    setGuestPassword(cfg.guestPass)
  end
  -- SSH 访问设置
  local ssh = cfg.ssh
  if type(ssh) == 'table' then
    uciSet('dropbear', '@dropbear[0]', 'enable', ssh.enabled and '1' or '0')
    if ssh.localPort and tonumber(ssh.localPort) then
      uciSet('dropbear', '@dropbear[0]', 'Port', tostring(ssh.localPort))
    end
    uciSet('dropbear', '@dropbear[0]', 'PasswordAuth', (ssh.passwordAuth == false or ssh.passwordAuth == 'false' or ssh.passwordAuth == 0 or ssh.passwordAuth == '0') and 'off' or 'on')
    uciCommit('dropbear')
    -- 认证密钥写入 /etc/dropbear/authorized_keys
    local keyText = ssh.authKey or ''
    if keyText ~= '' then
      os.execute("mkdir -p /etc/dropbear")
      local kf = io.open('/etc/dropbear/authorized_keys', 'w')
      if kf then
        -- 关键：gsub 返回 (新串, 替换次数) 两个值，直接喂变参 file:write 会把计数数字追加进
        -- authorized_keys 末尾（如 "...AAA==1"），dropbear 解析非法行会拒绝整把密钥登录。
        -- 必须用括号只取第一个返回值（v1.1.3 同类多返回值事故，此修复补漏）。
        kf:write((keyText:gsub('\r\n', '\n'):gsub('\r', '\n')))
        kf:close()
      end
    else
      os.execute("rm -f /etc/dropbear/authorized_keys")
    end
    -- 远程访问防火墙
    if ssh.remoteAccess and ssh.remotePort and tonumber(ssh.remotePort) then
      uciSet('firewall', 'golden_ssh_remote', 'name', 'golden_ssh_remote')
      uciSet('firewall', 'golden_ssh_remote', 'src', 'wan')
      uciSet('firewall', 'golden_ssh_remote', 'proto', 'tcp')
      uciSet('firewall', 'golden_ssh_remote', 'src_dport', tostring(ssh.remotePort))
      uciSet('firewall', 'golden_ssh_remote', 'dest_port', tostring(ssh.localPort or 22))
      uciSet('firewall', 'golden_ssh_remote', 'target', 'ACCEPT')
      uciSet('firewall', 'golden_ssh_remote', 'family', 'ipv4')
      uciCommit('firewall')
      os.execute('/etc/init.d/firewall reload 2>/dev/null &')
    else
      os.execute("uci delete firewall.golden_ssh_remote 2>/dev/null")
      uciCommit('firewall')
      os.execute('/etc/init.d/firewall reload 2>/dev/null &')
    end
    os.execute('/etc/init.d/dropbear restart 2>/dev/null &')
  end
  uciCommit('uhttpd')
  uciCommit('system')
  os.execute('/etc/init.d/uhttpd restart 2>/dev/null &')

  -- 静态路由
  local routes = cfg.staticRoutes or {}
  for i, r in ipairs(routes) do
    if r.target and r.gateway then
      local rn = 'golden_sr' .. i
      os.execute("uci delete network." .. rn .. " 2>/dev/null")
      uciSet('network', rn, 'target', sanitize(r.target, '^[%d%.%/]+$'))
      uciSet('network', rn, 'gateway', sanitize(r.gateway, IPPAT))
      uciSet('network', rn, 'interface', sanitize(r.interface or 'lan', '^[%w_]+$'))
      uciSet('network', rn, 'type', 'route')
    end
  end
  uciCommit('network')
  os.execute('/etc/init.d/network reload 2>/dev/null &')
  return true
end

