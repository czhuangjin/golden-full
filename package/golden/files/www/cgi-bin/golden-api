-- ---- 域名重定向（golden.domredir_* + dnsmasq address 生效） ----
local function saveDomainRedirect(cfg)
  cfg = cfg or {}
  local rules = cfg.rules
  if type(rules) ~= 'table' then rules = {} end
  for _, sec in ipairs(listSections('domredir_')) do os.execute("uci -q delete golden." .. sec) end
  for i, r in ipairs(rules) do
    local sec = 'domredir_' .. i
    uciSet('golden', sec, 'active', (r.active == true or r.active == 1 or r.active == '1') and '1' or '0')
    uciSet('golden', sec, 'log', (r.log == true or r.log == 1 or r.log == '1') and '1' or '0')
    uciSet('golden', sec, 'desc', clean(r.desc or ''))
    uciSet('golden', sec, 'urlhost', clean(r.urlHost or ''))
    uciSet('golden', sec, 'targeturl', clean(r.targetUrl or ''))
    uciSet('golden', sec, 'urlparam', clean(r.urlParam or ''))
    uciSet('golden', sec, 'redirectto', clean(r.redirectTo or ''))
    uciSet('golden', sec, 'appendurl', (r.appendUrl == true or r.appendUrl == 1 or r.appendUrl == '1') and '1' or '0')
    uciSet('golden', sec, 'range', clean(r.range or ''))
    uciSet('golden', sec, 'timecontrol', (r.timeControl == true or r.timeControl == 1 or r.timeControl == '1') and '1' or '0')
    uciSet('golden', sec, 'timeslots', clean(r.timeSlots or ''))
  end
  uciCommit('golden')
  -- 生效：写 dnsmasq address=/域名/重定向IP
  os.execute("mkdir -p /tmp/dnsmasq.d && rm -f /tmp/dnsmasq.d/golden-redirect.conf")
  local conf = io.open('/tmp/dnsmasq.d/golden-redirect.conf', 'w')
  if conf then
    for _, r in ipairs(rules) do
      local active = (r.active == true or r.active == 1 or r.active == '1')
      if active and r.urlHost and r.urlHost ~= '' and r.redirectTo and r.redirectTo ~= '' then
        local host = tostring(r.urlHost):gsub('^%*%.', ''):gsub('%*', ''):gsub('%s+', '')
        local to = sanitize(r.redirectTo, IPPAT)
        if host ~= '' and to ~= '' then conf:write('address=/' .. host .. '/' .. to .. '\n') end
      end
    end
    conf:close()
    os.execute("/etc/init.d/dnsmasq restart 2>/dev/null &")
  end
  return true
end

-- ---- MAC 地址设置（network device mac） ----
