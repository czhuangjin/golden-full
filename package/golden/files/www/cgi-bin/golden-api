local function runPing(host)
  host = sanitize(host, '^[%w_%-%.]+$')
  if host == '' then error('host 参数缺失') end
  local out = sh("ping -c 4 -W 2 '" .. host .. "' 2>&1")
  local sent = out:match('(%d+) packets transmitted') or '4'
  local recv = out:match('(%d+) packets received') or '0'
  local loss = out:match('(%d+)%% packet loss') or '100'
  local min = out:match('min/avg/max.*= [%d%.]+/([%d%.]+)/') or ''
  local result = { host = host, sent = sent, received = recv, loss = loss .. '%', avg = min }
  -- 逐行输出
  local rows = {}
  for line in out:gmatch('[^\n]+') do
    local seq, ttl, t = line:match('icmp_seq=(%d+) ttl=(%d+) time=([%d%.]+) ms')
    if seq then rows[#rows + 1] = { seq = seq, ttl = ttl, time = t } end
  end
  result.rows = rows
  return result
end

