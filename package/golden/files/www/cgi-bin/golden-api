-- ---- 带宽保证（golden.guarrule_*，配置持久化；tc 生效由 speedlimit.sh 聚合） ----
local function saveBandwidthGuarantee(cfg)
  cfg = cfg or {}
  local rules = cfg.rules
  if type(rules) ~= 'table' then rules = {} end
  for _, sec in ipairs(listSections('guarrule_')) do os.execute("uci -q delete golden." .. sec) end
  for i, r in ipairs(rules) do
    local sec = 'guarrule_' .. i
    uciSet('golden', sec, 'active', (r.active == true or r.active == 1 or r.active == '1') and '1' or '0')
    uciSet('golden', sec, 'desc', clean(r.desc or ''))
    uciSet('golden', sec, 'mode', clean(r.mode or 'exclusive'))
    uciSet('golden', sec, 'range', clean(r.range or ''))
    uciSet('golden', sec, 'up', tonumber(r.up) or 0)
    uciSet('golden', sec, 'down', tonumber(r.down) or 0)
    local wans = r.wans
    if type(wans) ~= 'table' or #wans == 0 then wans = { 'WAN1' } end
    uciSet('golden', sec, 'wans', table.concat(wans, ','))
    uciSet('golden', sec, 'timecontrol', (r.timeControl == true or r.timeControl == 1 or r.timeControl == '1') and '1' or '0')
    uciSet('golden', sec, 'timeslots', clean(r.timeSlots or ''))
  end
  uciCommit('golden')
  os.execute('sh /etc/golden/speedlimit.sh restart 2>/dev/null &')
  return true
end

