-- ==================== 批2：速度限制 / 连接限制 / DDOS / 私接DHCP ====================

local function ip2num(s)
  local a, b, c, d = s:match('^(%d+)%.(%d+)%.(%d+)%.(%d+)$')
  if not a then return nil end
  return tonumber(a) * 16777216 + tonumber(b) * 65536 + tonumber(c) * 256 + tonumber(d)
end
local function num2ip(n)
  n = math.floor(n)
  local a = math.floor(n / 16777216) % 256
  local b = math.floor(n / 65536) % 256
  local c = math.floor(n / 256) % 256
  local d = n % 256
  return a .. '.' .. b .. '.' .. c .. '.' .. d
end
-- 宽松清洗：中文保留，仅去 shell 危险字符
local function clean(s)
  s = tostring(s or '')
  return (s:gsub("[';`$|&<>]", ''):gsub('[\r\n]', ''))
end
-- 解析主机范围字符串 → {rstart, rend}（支持 单IP / IP-IP / IP-N / CIDR）
local function parseRange(str)
  local s = tostring(str or ''):gsub('%s+', '')
  local res = { rstart = '', rend = '' }
  if s == '' then return res end
  local a, b = s:match('^(%d+%.%d+%.%d+%.%d+)%-(%d+%.%d+%.%d+%.%d+)$')
  if not a then a, b = s:match('^(%d+%.%d+%.%d+%.%d+)%-(%d+)$') end
  if a then
    res.rstart = a
    if b:match('^%d+$') then
      local p1, p2, p3 = a:match('^(%d+)%.(%d+)%.(%d+)')
      res.rend = p1 .. '.' .. p2 .. '.' .. p3 .. '.' .. b
    else
      res.rend = b
    end
    return res
  end
  local ip, cidr = s:match('^(%d+%.%d+%.%d+%.%d+)/(%d+)$')
  if ip and tonumber(cidr) then
    local bits = math.min(32, math.max(0, tonumber(cidr)))
    local n = ip2num(ip)
    local count = 2 ^ (32 - bits)
    local base = math.floor(n / count) * count
    res.rstart = num2ip(base)
    res.rend = num2ip(base + count - 1)
    return res
  end
  if s:match(IPPAT) then
    res.rstart = s
    res.rend = s
  end
  return res
end
-- 展开起止 IP 为列表（上限 254），single 模式使用
local function expandRange(rstart, rend)
  local s = ip2num(rstart)
  local e = ip2num(rend)
  if not s or not e then return nil end
  if s > e then s, e = e, s end
  if e - s > 254 then return nil end
  local ips = {}
  for i = s, e do ips[#ips + 1] = num2ip(i) end
  return ips
end
