    if fwport ~= '' then
      info.remoteAccess = true
      info.remotePort = tonumber(fwport) or 8080
    end
  end
  info.adminUser = sh("uci get system.@system[0].golden_admin_user 2>/dev/null") ~= '' and sh("uci get system.@system[0].golden_admin_user 2>/dev/null") or 'root'
