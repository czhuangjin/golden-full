-- UCI 接口 id → 前端显示名（wan→广域网1）
local function wanNameOf(id)
  id = tostring(id or '')
  if id == 'wan' then return '广域网1' end
  local n = id:match('^wan(%d)$')
  if n then return '广域网' .. n end
  return id
end
-- 前端显示名 → UCI 接口 id
local function wanUcId(name)
  local map = { ['广域网1'] = 'wan', ['广域网2'] = 'wan2', ['广域网3'] = 'wan3', ['广域网4'] = 'wan4', vpn1 = 'vpn1', vpn2 = 'vpn2' }
  return map[tostring(name or '')] or tostring(name or '')
end

-- ---- 重写 saveQos：适配前端 qos 对象 { enabled, mode, wans[], exceptions{} } ----
local function saveQos(cfg)
  cfg = cfg or {}
  local mode = sanitize(cfg.mode or 'smart', '^[%w_]+$')
  if mode ~= '' then uciSet('golden', 'qos', 'mode', mode) end
  local wans = cfg.wans
  if type(wans) == 'table' then
    for _, w in ipairs(wans) do
      local dev = wanDev(w.name or '')
      if dev ~= '' then
        local up = tonumber(w.up) or 0
        local down = tonumber(w.down) or 0
        local on = (up > 0) or (down > 0)
        local en = on and (cfg.enabled == true or cfg.enabled == '1' or cfg.enabled == 1)
        uciSet('sqm', dev, 'enabled', en and '1' or '0')
        if down > 0 then uciSet('sqm', dev, 'download', tostring(down)) end
        if up > 0 then uciSet('sqm', dev, 'upload', tostring(up)) end
        uciSet('sqm', dev, 'interface', dev)
        uciSet('sqm', dev, 'qdisc', 'fq_codel')
        uciSet('sqm', dev, 'script', 'piece_of_cake.qos')
      end
    end
    uciCommit('sqm')
  end
  os.execute("uci -q delete golden.qos.ex_ip 2>/dev/null; uci -q delete golden.qos.ex_dom 2>/dev/null")
  local ex = cfg.exceptions
  if type(ex) == 'table' then
    if type(ex.ip) == 'table' then
      for _, e in ipairs(ex.ip) do
        local v = sanitize(e.value or '', '^[%w%.:%*%-]+$')
        if v ~= '' then uciAddList('golden', 'qos', 'ex_ip', v) end
      end
    end
    if type(ex.domain) == 'table' then
      for _, e in ipairs(ex.domain) do
        local v = sanitize(e.value or '', '^[%w%.:%*%-]+$')
        if v ~= '' then uciAddList('golden', 'qos', 'ex_dom', v) end
      end
    end
  end
  uciCommit('golden')
  os.execute('/etc/init.d/sqm restart 2>/dev/null &')
  return true
end

-- ---- 静态路由（独立域，写 network.golden_sr*） ----
local function saveStaticRoutes(cfg)
