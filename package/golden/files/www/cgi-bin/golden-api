  info.sessionTimeout = tonumber(sh("uci get system.@system[0].golden_session_timeout 2>/dev/null")) or 15
  -- 远程访问白名单（uci 持久化；防火墙规则里的 src_ip 也可反推）
  local allow = sh("uci get system.@system[0].golden_remote_allow 2>/dev/null")
  if allow == '' then
    local ips = {}
    local firstIp = sh("uci get firewall.golden_remote.src_ip 2>/dev/null")
    if firstIp ~= '' then ips[#ips + 1] = firstIp end
    for i = 2, 20 do
      local ip = sh("uci get firewall.golden_remote_" .. i .. ".src_ip 2>/dev/null")
      if ip ~= '' then ips[#ips + 1] = ip else break end
    end
    allow = table.concat(ips, ',')
  end
  info.remoteAllow = allow
  -- SSH 访问设置（dropbear）
  local ssh = { enabled = false, localPort = 22, remoteAccess = false, remotePort = 2222, passwordAuth = true, authKey = '' }
  local dropEnabled = sh("uci get dropbear.@dropbear[0].enable 2>/dev/null")
  if dropEnabled == '' then dropEnabled = '1' end
  ssh.enabled = (dropEnabled == '1')
  local dropPort = sh("uci get dropbear.@dropbear[0].Port 2>/dev/null")
  if dropPort ~= '' then ssh.localPort = tonumber(dropPort) or 22 end
  local passAuth = sh("uci get dropbear.@dropbear[0].PasswordAuth 2>/dev/null")
  if passAuth == '' then passAuth = 'on' end
  ssh.passwordAuth = (passAuth == 'on' or passAuth == '1')
  -- 远程访问：通过防火墙规则判断
  local sshFwPort = sh("uci get firewall.golden_ssh_remote.src_dport 2>/dev/null")
  if sshFwPort ~= '' then
    ssh.remoteAccess = true
    ssh.remotePort = tonumber(sshFwPort) or 2222
  end
  -- 认证密钥
  local keyLines = {}
  local f = io.open('/etc/dropbear/authorized_keys', 'r')
  if f then
    for line in f:lines() do if line ~= '' then keyLines[#keyLines + 1] = line end end
    f:close()
  end
  ssh.authKey = table.concat(keyLines, '\n')
  info.ssh = ssh
  return info
end
