#!/usr/bin/lua
-- ============================================================
-- 黄金定制 完整版 — 后端数据接口 v3（OpenWrt / uhttpd CGI）
-- 读取: GET  ?action=get&name=sysinfo|laninfo|waninfo|hosts|arp|traffic|conns|logs|processes|lbstatus|upnp|ddns|qos|config
--       兼容 v1: ?action=sysinfo 直接返回
-- 批5:   + secevents（安全事件聚合）| banlist（封禁列表）| dnsaudit|dnsauditlogs（上网行为审计）
-- 写入: POST body=JSON {"domain":"network.wan","config":{...}}
-- 操作: POST ?action=run&name=ping|reboot|poweroff|reset|restartservice|backup|restore|upgrade|upgrade-confirm|ctcnc-*|login-banlist|login-unban|arplog-clear|dnsblock-clear|dnsaudit-clear|block-ip|unblock-ip
-- 安全: token 一律走请求头 X-Golden-Token（不再接受 URL 参数）；
--       危险/有副作用操作强制 POST（CSRF 防护）；会话绑定来源 IP；
--       登录失败达阈值 → 应用层锁定 + iptables recent 封禁双保险
-- 输出: {"ok":true,"error":"","payload":{...}}
-- 说明: 纯 Lua 5.1，无第三方依赖
-- ============================================================

local query = os.getenv('QUERY_STRING') or ''
local args = {}
for k, v in query:gmatch('([%w_]+)=([^&]*)') do args[k] = v end

-- ==================== JSON 编码器 ====================
local function esc(s)
  s = tostring(s or '')
  s = s:gsub('\\', '\\\\'):gsub('"', '\\"'):gsub('\n', '\\n'):gsub('\r', '\\r'):gsub('\t', '\\t')
  return s
end
local function jenc(o)
  local t = type(o)
  if t == 'table' then
    local n = #o
    if n > 0 then
      local parts = {}
      for i = 1, n do parts[i] = jenc(o[i]) end
      return '[' .. table.concat(parts, ',') .. ']'
    else
      local parts = {}
      for k, v in pairs(o) do parts[#parts + 1] = '"' .. esc(k) .. '":' .. jenc(v) end
      return '{' .. table.concat(parts, ',') .. '}'
    end
  elseif t == 'number' then return tostring(o)
  elseif t == 'boolean' then return o and 'true' or 'false'
  else return '"' .. esc(o) .. '"' end
end

-- ==================== 最小 JSON 解析器（lua5.1） ====================
local function json_parse(str)
  local idx = 1
  local function skip()
    while str:sub(idx, idx):match('%s') do idx = idx + 1 end
  end
  local function parse()
    skip()
    local c = str:sub(idx, idx)
    if c == '{' then
      idx = idx + 1; skip()
      local obj = {}
      if str:sub(idx, idx) == '}' then idx = idx + 1 return obj end
      while true do
        local key = parse(); skip()
        if str:sub(idx, idx) ~= ':' then error('expected :') end
        idx = idx + 1
        obj[key] = parse(); skip()
        local cc = str:sub(idx, idx)
        if cc == ',' then idx = idx + 1
        elseif cc == '}' then idx = idx + 1 return obj
        else error('bad obj') end
      end
    elseif c == '[' then
      idx = idx + 1; skip()
      local arr = {}
      if str:sub(idx, idx) == ']' then idx = idx + 1 return arr end
      while true do
        arr[#arr + 1] = parse(); skip()
        local cc = str:sub(idx, idx)
        if cc == ',' then idx = idx + 1
        elseif cc == ']' then idx = idx + 1 return arr
        else error('bad arr') end
      end
    elseif c == '"' then
      idx = idx + 1
      local out = ''
      while true do
        local ch = str:sub(idx, idx)
        if ch == '"' then idx = idx + 1 return out end
        if ch == '\\' then
          idx = idx + 1
          local e = str:sub(idx, idx)
          if e == 'n' then out = out .. '\n'
          elseif e == 't' then out = out .. '\t'
          elseif e == 'r' then out = out .. '\r'
          elseif e == 'u' then
            local code = tonumber(str:sub(idx + 1, idx + 4), 16)
            out = out .. (code and string.char(code % 256) or '')
            idx = idx + 4
          else out = out .. e end
          idx = idx + 1
        else
          out = out .. ch
          idx = idx + 1
        end
      end
    elseif c == '-' or (c and c:match('%d')) then
      local num = str:match('^-?%d+%.?%d*[eE]?[+-]?%d*', idx) or '0'
      idx = idx + #num
      return tonumber(num)
    elseif c == 't' then idx = idx + 4 return true
    elseif c == 'f' then idx = idx + 5 return false
    elseif c == 'n' then idx = idx + 4 return nil
    else error('bad char ' .. tostring(c)) end
  end
  return parse()
end

-- ==================== 工具函数 ====================
local function sh(cmd)
  local f = io.popen(cmd .. ' 2>/dev/null', 'r')
  if not f then return '' end
  local s = f:read('*a') or ''
  f:close()
  return (s:gsub('[\r\n]+$', ''))
end
local function readFile(path)
  local f = io.open(path, 'r')
  if not f then return '' end
  local s = f:read('*a') or ''
  f:close()
  return s
end
local function urldecode(s)
  s = s:gsub('%+', ' ')  -- '+' 是 Lua pattern 魔法字符，必须转义，否则整段 URL 解码抛 malformed pattern
  return (s:gsub('%%(%x%x)', function(h) return string.char(tonumber(h, 16)) end))
end
local function sanitize(v, pat)
  v = tostring(v or '')
  if pat and not v:match(pat) then return '' end
  return (v:gsub("[';`$|&<>]", ''))
end
local function cidrToMask(n)
  n = tonumber(n) or 24
  if n < 0 then n = 0 end
  if n > 32 then n = 32 end
  local mask = 0
  for i = 0, 31 do if i < n then mask = mask + 2 ^ (31 - i) end end
  local a = math.floor(mask / 16777216)
  local b = math.floor((mask % 16777216) / 65536)
  local c = math.floor((mask % 65536) / 256)
  local d = math.floor(mask % 256)
  return a .. '.' .. b .. '.' .. c .. '.' .. d
end
local IPPAT = '^%d+%.%d+%.%d+%.%d+$'
local MACPAT = '^%x%x:%x%x:%x%x:%x%x:%x%x:%x%x$'

-- 纯 Lua base64 编解码（busybox 默认不编译 base64 applet，CONFIG_BUSYBOX_DEFAULT_BASE64=n）
local B64C = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local function b64encode(data)
  local out = {}
  for i = 1, #data, 3 do
    local a, b, c = data:byte(i, i + 2)
    local n = a * 65536 + (b or 0) * 256 + (c or 0)
    local q = {}
    for j = 3, 0, -1 do
      local v = math.floor(n / 64 ^ j) % 64
      q[#q + 1] = B64C:sub(v + 1, v + 1)
    end
    local s = table.concat(q)
    if not c then s = s:sub(1, 3) .. '=' end
    if not b then s = s:sub(1, 2) .. '==' end
    out[#out + 1] = s
  end
  return table.concat(out)
end
local function b64decode(str)
  str = str:gsub('[^' .. B64C .. '=]', '')
  local out = {}
  for chunk in str:gmatch('....') do
    local n = 0
    for i = 1, 4 do
      local ch = chunk:sub(i, i)
      if ch ~= '=' then n = n * 64 + (B64C:find(ch, 1, true) - 1) else n = n * 64 end
    end
    out[#out + 1] = string.char(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
  end
  return table.concat(out)
end

-- ==================== 认证 / 会话管理 ====================
-- 带错误码的异常：error({code=401, msg='...'}) → 输出 {ok:false, code:401, error:'...'}
local SESSION_DIR = '/tmp/golden_sessions'
local LOCK_DIR = '/tmp/golden_lock'

-- token 统一从请求头 X-Golden-Token 获取（不再接受 URL 参数，避免 token 泄露到 uhttpd 访问日志 / Referer）
local function headerToken()
  return os.getenv('HTTP_X_GOLDEN_TOKEN') or ''
end

-- 读取 POST body（限量，防内存耗尽）
local function readPostBody(maxSize)
  local method = os.getenv('REQUEST_METHOD') or 'GET'
  if method ~= 'POST' then return '' end
  local cl = tonumber(os.getenv('CONTENT_LENGTH') or '0') or 0
  if cl <= 0 or cl > (maxSize or 1048576) then return '' end
  return io.read(cl) or ''
end

-- 危险/有副作用操作必须 POST（CSRF 防护：GET 可被 <img>/<script> 触发）
local function requirePost()
  local m = os.getenv('REQUEST_METHOD') or 'GET'
  if m ~= 'POST' then error({ code = 405, msg = '该操作需要通过 POST 请求执行' }) end
end

-- 登录失败达阈值 → iptables recent 封禁来源 IP（双保险：应用层锁定 + 内核层封禁）
-- 封禁时长由 golden-fw 按 UCI system.@system[0].golden_ban_seconds 执行（默认 600 秒；
-- 设 0 表示只做应用层锁定、不下发内核封禁）。被封后重启路由器即可解除（recent 表在内存）。
local BAN_SECONDS = tonumber(sh("uci get system.@system[0].golden_ban_seconds 2>/dev/null")) or 600
local function banIpByIptables(ip)
  if not ip or ip == '' or ip == 'local' then return end
  os.execute("iptables -C golden_login -m recent --name glb --set -j DROP -s " .. ip .. " 2>/dev/null || iptables -A golden_login -m recent --name glb --set -j DROP -s " .. ip .. " 2>/dev/null")
end

local function getClientIp()
  return os.getenv('REMOTE_ADDR') or 'local'
end

-- 验证系统密码：busybox cryptpw 按 /etc/shadow 的算法与 salt 重新计算比对
local function verifyPassword(user, pass)
  user = sanitize(user, '^[%w_]+$')
  if user == '' or not pass or pass == '' then return false end
  local line = sh("grep '^" .. user .. ":' /etc/shadow 2>/dev/null")
  local hash = line:match('^[^:]+:([^:]*)')
  if not hash or hash == '' or hash:sub(1, 1) == '!' or hash:sub(1, 1) == '*' then
    -- 账户锁定或 /etc/shadow 无该用户 → 直接失败（不落应急通道，避免绕过锁定）
    return false
  end
  local id, salt, enc = hash:match('^%$(%w+)%$([^$]*)%$([^$]*)')
  if not id or id == '' or salt == '' or enc == '' then return false end
  local alg = (id == '1' and 'md5') or (id == '5' and 'sha256') or (id == '6' and 'sha512') or ''
  if alg == '' then return false end
  local safe = tostring(pass):gsub("'", "'\\''")
  -- ★ 主通道：cryptpw 按 /etc/shadow 的真实算法+salt 重算比对。shadow 哈希是权威凭证，
  --   固件已按 CONFIG_BUSYBOX_DEFAULT_CRYPTPW=y 编入 cryptpw（v1.1.8 起），此处必然可判定。
  local out = sh("echo '" .. safe .. "' | busybox cryptpw -a " .. alg .. " -S '" .. salt .. "' 2>/dev/null")
  local newEnc = out:match('^%$%w+%$[^$]*%$([^$]*)')
  if newEnc ~= '' and newEnc == enc then return true end
  -- 降级通道①：固件无 cryptpw 时借道 dropbear 自带客户端 dbclient 验证（DROPBEAR_PASSWORD 环境变量）
  -- 判定必须用「肯定信号」：只有真实登录成功、远端命令执行输出了标记才放行。
  -- （旧写法按「输出不含 login failed/refused」推断成功，而 dbclient 密码错误的实际文案是
  --   "Password auth failed"，两个模式都不含 → 错误密码被放行，v1.1.7 已修）
  if sh("command -v dbclient 2>/dev/null") ~= '' then
    local f = io.popen("DROPBEAR_PASSWORD='" .. safe .. "' dbclient -y " .. user .. "@127.0.0.1 'echo GOLDEN_AUTH_OK' 2>/dev/null", 'r')
    local o = f and f:read('*a') or ''
    if f then f:close() end
    if o:match('GOLDEN_AUTH_OK') then return true end
  end
  -- 降级通道②（最后兜底）：uci 显式配置 golden_web_pass 明文时比对。
  --   【v1.1.10 安全加固】由「置于最前」移到「最后」：shadow 哈希（主通道）与 dbclient 均
  --   失败时才启用，且绝不绕过账户锁定。避免「shadow 已是新密码、golden_web_pass 仍是旧值」
  --   时旧密码仍能登录的凭证不一致问题；仅当设备连 cryptpw+dbclient 都没有（纯手工应急，
  --   如 SSH 里 uci set system.golden_web_pass='xxx'）才放行，保证 Web 永不锁死。
  local upass = sh("uci -q get system.@system[0].golden_web_pass 2>/dev/null")
  if upass ~= '' and upass == tostring(pass) then return true end
  return false
end

local function sessionToken()
  -- 注意：OpenWrt busybox 默认不编 od（BUSYBOX_DEFAULT_OD=n），严禁依赖 od 做十六进制转换
  -- 首选 tr 直接从 /dev/urandom 取十六进制字符（tr/head 必然内置）
  local t = sh("tr -dc 'a-f0-9' < /dev/urandom 2>/dev/null | head -c 64")
  if t == '' or #t < 32 then
    -- 纯 Lua 兜底：时间 + 时钟微秒做种子，保证任何精简固件都能出 token
    math.randomseed(os.time() * 1000 + math.floor((os.clock() % 1) * 1000000))
    local chars = '0123456789abcdef'
    t = ''
    for _ = 1, 64 do
      local i = math.random(1, #chars)
      t = t .. chars:sub(i, i)
    end
  end
  return t
end

local function createSession(user, role, ip)
  local token = sessionToken()
  if token == '' then return nil end
  os.execute('mkdir -p ' .. SESSION_DIR .. '; chmod 700 ' .. SESSION_DIR)
  local path = SESSION_DIR .. '/' .. token
  local now = os.time()
  local f = io.open(path, 'w')
  if not f then return nil end
  f:write('user=' .. user .. '\nrole=' .. role .. '\nip=' .. (ip or '') .. '\nlogin=' .. now .. '\nlast=' .. now .. '\n')
  f:close()
  os.execute('chmod 600 ' .. path)
  return token
end

local function checkSession(token)
  if not token or not token:match('^[%w]+$') then return nil end
  local path = SESSION_DIR .. '/' .. token
  local content = readFile(path)
  if content == '' then return nil end
  local user = content:match('^user=([^\n]+)')
  local role = content:match('^role=([^\n]+)')
  local sessIp = content:match('^ip=([^\n]+)')
  local last = tonumber(content:match('^last=(%d+)'))
  local timeout = tonumber(sh("uci get system.@system[0].golden_session_timeout 2>/dev/null")) or 15
  local now = os.time()
  -- 会话绑定来源 IP：换 IP 即视为 token 泄露，作废会话
  local curIp = getClientIp()
  if sessIp and sessIp ~= '' and curIp ~= 'local' and sessIp ~= curIp then
    os.execute('rm -f ' .. path)
    return nil
  end
  if not last or (now - last) > timeout * 60 then
    os.execute('rm -f ' .. path)
    return nil
  end
  os.execute("sed -i 's/^last=.*/last=" .. now .. "/' " .. path .. " 2>/dev/null")
  return { user = user, role = role }
end

local function destroySession(token)
  if token and token:match('^[%w]+$') then
    os.execute('rm -f ' .. SESSION_DIR .. '/' .. token)
  end
end

-- 登录失败锁定（按来源 IP，超过 golden_login_lock 次锁定；达阈值同时下发 iptables 封禁双保险）
-- 锁文件第 1 行=失败次数，第 2 行=首次失败时间戳；锁定 30 分钟后自动解锁（否则误输 5 次后永久锁死）
local LOCK_EXPIRE = 1800
local clearFail  -- 前置声明：lockedOut 过期自动解锁时需要调用
local function failCount(ip)
  return tonumber(sh("head -n1 " .. LOCK_DIR .. '/' .. ip .. " 2>/dev/null")) or 0
end
local function failTime(ip)
  return tonumber(sh("sed -n '2p' " .. LOCK_DIR .. '/' .. ip .. " 2>/dev/null")) or 0
end
local function lockedOut(ip)
  local max = tonumber(sh("uci get system.@system[0].golden_login_lock 2>/dev/null")) or 5
  if failCount(ip) < max then return false end
  local t0 = failTime(ip)
  if t0 > 0 and (os.time() - t0) >= LOCK_EXPIRE then
    clearFail(ip)
    return false
  end
  return true
end
local function recordFail(ip)
  os.execute('mkdir -p ' .. LOCK_DIR)
  local n = failCount(ip) + 1
  local t0 = failTime(ip)
  if t0 <= 0 then t0 = os.time() end
  os.execute('echo ' .. n .. ' > ' .. LOCK_DIR .. '/' .. ip)
  os.execute('echo ' .. t0 .. ' >> ' .. LOCK_DIR .. '/' .. ip)
  local max = tonumber(sh("uci get system.@system[0].golden_login_lock 2>/dev/null")) or 5
  if n >= max then
    banIpByIptables(ip)
    os.execute("logger -t golden-auth 'login brute-force banned " .. ip .. "' 2>/dev/null")
  end
end
clearFail = function(ip)
  os.execute('rm -f ' .. LOCK_DIR .. '/' .. ip)
end

-- 登录用户名 → 系统账户/角色 映射（支持 WEB 访问设置中的别名）
-- 返回 account(实际 shadow 账户), role(admin/guest), display(界面显示名)
local function resolveLogin(loginName)
  local adminAlias = sh("uci get system.@system[0].golden_admin_user 2>/dev/null") or 'root'
  local guestAlias = sh("uci get system.@system[0].golden_guest_user 2>/dev/null") or 'guest'
  if loginName == 'root' or (adminAlias ~= '' and loginName == adminAlias) then
    return 'root', 'admin', loginName
  elseif loginName == 'guest' or (guestAlias ~= '' and loginName == guestAlias) then
    return 'guest', 'guest', loginName
  end
  return nil
end

local function authLogin(cfg)
  cfg = cfg or {}
  local loginName = sanitize(cfg.user, '^[%w_]+$')
  local pass = tostring(cfg.pass or '')
  local ip = getClientIp()
  if loginName == '' or pass == '' then error('用户名或密码不能为空') end
  if lockedOut(ip) then error('登录失败次数过多，请稍后再试') end
  local account, role, display = resolveLogin(loginName)
  if not account then error('不支持的登录用户') end
  if not verifyPassword(account, pass) then
    recordFail(ip)
    error('用户名或密码错误')
  end
  clearFail(ip)
  local token = createSession(display, role, ip)
  if not token then error('会话创建失败，请重试') end
  local resp = { token = token, role = role, user = display, firstLogin = false }
  if role == 'admin' then
    resp.firstLogin = (sh("uci get system.@system[0].golden_first_login 2>/dev/null") == '1')
  end
  return resp
end

local function authCheck(token)
  if not token or token == '' then return { authenticated = false } end
  local s = checkSession(token)
  if not s then return { authenticated = false } end
  return { authenticated = true, role = s.role, user = s.user }
end

local function authLogout(token)
  destroySession(token)
  return { loggedOut = true }
end

-- ==================== UCI 封装 ====================
local function uciSet(section, option, value)
  if value == nil or value == '' then
    os.execute("uci delete " .. section .. "." .. option .. " 2>/dev/null")
  else
    value = tostring(value):gsub("'", "'\\''")
    os.execute("uci set " .. section .. "." .. option .. "='" .. value .. "'")
  end
end
local function uciAddList(section, option, value)
  value = tostring(value):gsub("'", "'\\''")
  os.execute("uci add_list " .. section .. "." .. option .. "='" .. value .. "'")
end
local function uciCommit(section) os.execute("uci commit " .. section .. " 2>/dev/null") end

-- ==================== 读取：系统信息 ====================
local function getSysinfo()
  local info = {}
  local up = readFile('/proc/uptime'):match('^([%d%.]+)') or '0'
  local sec = math.floor(tonumber(up) or 0)
  local d = math.floor(sec / 86400)
  local h = math.floor((sec % 86400) / 3600)
  local m = math.floor((sec % 3600) / 60)
  local s = sec % 60
  local function pad(x) return string.format('%02d', x) end
  info.runTime = (d > 0 and (d .. '天' .. pad(h) .. '时' .. pad(m) .. '分' .. pad(s) .. '秒'))
    or (h .. '时' .. pad(m) .. '分' .. pad(s) .. '秒')
  local cpuinfo = readFile('/proc/cpuinfo')
  info.cpuModel = cpuinfo:match('model name%s*:%s*([^\n]+)') or ''
  info.cpuCores = 0
  for _ in cpuinfo:gmatch('processor%s*:%s*') do info.cpuCores = info.cpuCores + 1 end
  info.cpuFreq = cpuinfo:match('cpu MHz%s*:%s*([^\n]+)') or ''
  info.load = readFile('/proc/loadavg'):match('^([%d%.]+%s+[%d%.]+%s+[%d%.]+)') or '0 0 0'
  local mem = readFile('/proc/meminfo')
  local mt = tonumber(mem:match('MemTotal:%s*(%d+)')) or 0
  local ma = tonumber(mem:match('MemAvailable:%s*(%d+)')) or 0
  info.memTotalG = string.format('%.2f', mt / 1024 / 1024)
  info.memFreeG = string.format('%.2f', ma / 1024 / 1024)
  local nf = readFile('/proc/net/nf_conntrack')
  local conns = 0
  for _ in nf:gmatch('[^\n]+') do conns = conns + 1 end
  info.currentConn = conns
  info.connCapacity = sh("cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null") or ''
  local tmp = sh("cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null")
  local t = tonumber(tmp)
  info.temp = t and string.format('%.1f', t / 1000) or ''
  info.release = readFile('/etc/openwrt_release'):match('DISTRIB_DESCRIPTION=%s*["\']([^"\']+)') or 'OpenWrt'
  info.hostname = readFile('/proc/sys/kernel/hostname'):gsub('%s+$', '')
  info.goldenVersion = '黄金定制 H-2.01.779'
  return info
end

-- ==================== 读取：局域网 ====================
local function getLaninfo()
  local info = {}
  info.ip = sh("uci get network.lan.ipaddr 2>/dev/null")
  info.mask = sh("uci get network.lan.netmask 2>/dev/null")
  if info.mask == '' then info.mask = '255.255.255.0' end
  info.mac = sh("cat /sys/class/net/br-lan/address 2>/dev/null")
  info.mtu = sh("cat /sys/class/net/br-lan/mtu 2>/dev/null")
  info.dhcpStart = sh("uci get dhcp.lan.start 2>/dev/null")
  info.dhcpLimit = sh("uci get dhcp.lan.limit 2>/dev/null")
  info.dhcpLease = sh("uci get dhcp.lan.leasetime 2>/dev/null")
  return info
end

-- ==================== 读取：广域网 ====================
local function getWaninfo()
  local wans = {}
  local wanIdx = 0
  local function addWan(name, proto, ifname)
    wanIdx = wanIdx + 1
    local dev = (ifname ~= '' and ifname) or name
    local w = { id = name, name = name, proto = proto or 'dhcp', ifname = dev,
      ip = '', mask = '', gateway = '', mac = '', mtu = '', dns1 = '', dns2 = '',
      status = '未连接', onlineTime = '' }
    local inet = sh("ip -4 addr show dev " .. dev .. " 2>/dev/null | grep 'inet ' | head -1")
    local ipPart, cidr = inet:match('inet (%d+%.%d+%.%d+%.%d+)/(%d+)')
    w.ip = ipPart or ''
    w.mask = cidr and cidrToMask(cidr) or ''
    w.mac = sh("cat /sys/class/net/" .. dev .. "/address 2>/dev/null")
    w.mtu = sh("cat /sys/class/net/" .. dev .. "/mtu 2>/dev/null")
    w.gateway = sh("ip route show default 2>/dev/null | grep -E 'dev " .. dev .. "' | awk '{print $3}' | head -1")
    if w.gateway == '' then w.gateway = sh("uci get network." .. name .. ".gateway 2>/dev/null") end
    local dnsAll = sh("uci get network." .. name .. ".dns 2>/dev/null")
    w.dns1 = dnsAll:match('([^ %s]+)') or ''
    w.dns2 = (dnsAll:match('[^ %s]+ ([^ %s]+)')) or ''
    local upCount = sh("ip link show dev " .. dev .. " 2>/dev/null | grep -c 'state UP'")
    if w.ip ~= '' and upCount == '1' then w.status = '在线'
    elseif ifname == '' then w.status = '未配置'
    else w.status = '未连接' end
    wans[#wans + 1] = w
  end
  local curName, curProto, curIf = '', '', ''
  for line in sh("uci show network"):gmatch('[^\n]+') do
    local n = line:match('^network%.([%w_]+)%=')
    if n then
      if curName ~= '' and curName:match('^wan') and curProto ~= 'dhcpv6' and curProto ~= '6in4' then
        addWan(curName, curProto, curIf)
      end
      curName, curProto, curIf = n, '', ''
    end
    local nm, pv = line:match('^network%.([%w_]+)%.proto=%s*[\'"]?([%w_]+)[\'"]?$')
    if nm and nm == curName then curProto = pv end
    local ni, iv = line:match('^network%.([%w_]+)%.ifname=%s*[\'"]?([%w_%.%-]+)[\'"]?$')
    if ni and ni == curName then curIf = iv end
  end
  if curName ~= '' and curName:match('^wan') and curProto ~= 'dhcpv6' and curProto ~= '6in4' then
    addWan(curName, curProto, curIf)
  end
  if #wans == 0 then addWan('wan', 'dhcp', 'eth1') end
  return wans
end

