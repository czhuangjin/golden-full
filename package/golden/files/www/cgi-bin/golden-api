local function saveDhcpDetect(cfg)
  local interval = tonumber(cfg.interval) or 30
  if interval < 5 then interval = 5 end
  if interval > 3600 then interval = 3600 end
  uciSet('golden', 'dhcpdetect', 'interval', interval)
  uciSet('golden', 'dhcpdetect', 'intercept', (cfg.intercept == true or cfg.intercept == 1 or cfg.intercept == '1') and '1' or '0')
  uciSet('golden', 'dhcpdetect', 'alert', clean(cfg.alert or '日志'))
  uciCommit('golden')
  os.execute('/etc/init.d/golden-dhcpdetect restart 2>/dev/null &')
  return true
end
local function getDhcpDetectLogs(limit)
  limit = tonumber(limit) or 50
  local out = {}
  local f = io.open('/tmp/golden_dhcpdetect.log', 'r')
  if f then
    local lines = {}
    for line in f:lines() do lines[#lines + 1] = line end
    f:close()
    local start = math.max(1, #lines - limit + 1)
    for i = start, #lines do
      local t, ev = lines[i]:match('^([^|]+)|(.+)$')
      if t then out[#out + 1] = { time = t, event = ev } end
    end
  end
  return out
end


local function getLbStatus()
  local lines = {}
  local out = sh("mwan3 status 2>/dev/null")
  for line in out:gmatch('[^\n]+') do
    local iface, st = line:match('^Interface (%S+) .-online.%s*: (%a+)')
    if iface then lines[#lines + 1] = { interface = iface, status = st } end
  end
  if #lines == 0 then
    for _, w in ipairs(getWaninfo()) do
      lines[#lines + 1] = { interface = w.id, status = w.status }
    end
  end
  return lines
end
local function getUpnp()
  local list = {}
  local out = sh("upnpc -l 2>/dev/null | grep -E '^\\s*[0-9]+\\s' | head -20")
  for line in out:gmatch('[^\n]+') do
    local proto, ext, ip, int = line:match('^%s*(%d+)%s+(%a+)%s+([%d%.]+:%d+)%s+->%s+([%d%.]+:%d+)')
    if proto then list[#list + 1] = { proto = proto, external = ext, internal = ip, target = int } end
  end
  return {
    list = list,
    enabled = (sh("uci -q get upnpd.config.enabled") == '1'),
    secure = (sh("uci -q get upnpd.config.secure_mode") == '1')
  }
end

-- ==================== 写入：网络 ====================
local function saveWan(cfg)
  local name = sanitize(cfg.id, '^[%w_]+$')
  if name == '' then name = 'wan' end
  local proto = sanitize(cfg.proto, '^[%w_]+$')
  if proto == '' then proto = 'dhcp' end
  uciSet('network', name, 'proto', proto)
  uciSet('network', name, 'username', cfg.username)
  uciSet('network', name, 'password', cfg.password)
  uciSet('network', name, 'ipaddr', sanitize(cfg.ip, IPPAT))
  uciSet('network', name, 'netmask', sanitize(cfg.mask, IPPAT))
  uciSet('network', name, 'gateway', sanitize(cfg.gateway, IPPAT))
  local dns = sanitize(cfg.dns1, '') .. ' ' .. sanitize(cfg.dns2, '')
  uciSet('network', name, 'dns', dns:match('^%s*$') and nil or dns)
  if cfg.mtu and tonumber(cfg.mtu) and tonumber(cfg.mtu) >= 576 then
    uciSet('network', name, 'mtu', cfg.mtu)
  end
  if cfg.mac and cfg.mac:match(MACPAT) then uciSet('network', name, 'macaddr', cfg.mac) end
  uciCommit('network')
  os.execute('/etc/init.d/network reload 2>/dev/null &')
  return true
end
local function saveLan(cfg)
  if cfg.ip and cfg.ip:match(IPPAT) then uciSet('network', 'lan', 'ipaddr', cfg.ip) end
  if cfg.mask and cfg.mask:match(IPPAT) then uciSet('network', 'lan', 'netmask', cfg.mask) end
  uciCommit('network')
  if cfg.dhcpStart and tonumber(cfg.dhcpStart) then uciSet('dhcp', 'lan', 'start', cfg.dhcpStart) end
  if cfg.dhcpLimit and tonumber(cfg.dhcpLimit) then uciSet('dhcp', 'lan', 'limit', cfg.dhcpLimit) end
  if cfg.dhcpLease then uciSet('dhcp', 'lan', 'leasetime', cfg.dhcpLease) end
  uciCommit('dhcp')
  os.execute('/etc/init.d/network reload 2>/dev/null & /etc/init.d/dnsmasq reload 2>/dev/null &')
  return true
end
local function saveDhcp(cfg)
  cfg = cfg or {}
  local enabled = not (cfg.enabled == false or cfg.enabled == 'false' or cfg.enabled == 0 or cfg.enabled == '0')
  uciSet('dhcp', 'lan', 'ignore', enabled and '0' or '1')
  -- 从起止 IP 计算 start/limit
  local startIp = cfg.start or '192.168.1.100'
  local endIp = cfg['end'] or cfg.endIp or '192.168.1.200'
  local lanIp = sh("uci get network.lan.ipaddr 2>/dev/null") or '192.168.1.1'
  local prefix = lanIp:match('^(%d+%.%d+%.%d+%.)') or '192.168.1.'
  local sNum = tonumber(startIp:match('^%d+%.%d+%.%d+%.(%d+)$')) or 100
  local eNum = tonumber(endIp:match('^%d+%.%d+%.%d+%.(%d+)$')) or 200
  uciSet('dhcp', 'lan', 'start', tostring(sNum))
  uciSet('dhcp', 'lan', 'limit', tostring(math.max(1, eNum - sNum)))
  if cfg.gateway and cfg.gateway:match(IPPAT) then
    uciSet('dhcp', 'lan', 'dhcp_option', "'3," .. cfg.gateway .. "'")
  end
  if cfg.dns1 and cfg.dns1:match(IPPAT) then
    local opt = cfg.dns2 and cfg.dns2:match(IPPAT) and
      "'6," .. cfg.dns1 .. "," .. cfg.dns2 .. "'" or "'6," .. cfg.dns1 .. "'"
    uciSet('dhcp', 'lan', 'dhcp_option', opt)
  elseif cfg.dns2 and cfg.dns2:match(IPPAT) then
    uciSet('dhcp', 'lan', 'dhcp_option', "'6," .. cfg.dns2 .. "'")
  end
  local lease = tonumber(cfg.lease) or 86400
  local h = math.floor(lease / 3600)
  uciSet('dhcp', 'lan', 'leasetime', h .. 'h')
  uciCommit('dhcp')
  os.execute('/etc/init.d/dnsmasq restart 2>/dev/null &')
  return true
end
local function saveSystem(cfg)
  if cfg.name then
    uciSet('system', '@system[0]', 'hostname', sanitize(cfg.name, '^[%w_%-%s]+$'))
    uciCommit('system')
    os.execute('/etc/init.d/system reload 2>/dev/null &')
  end
  if cfg.time then os.execute("date -s '" .. sanitize(cfg.time, '^[%w%:%s%-]+$') .. "' 2>/dev/null") end
  return true
end

