local function getDomainFilter()
  local rules = {}
  for _, sec in ipairs(listSections('domfilter_')) do
    rules[#rules + 1] = { id = tonumber(sec:match('(%d+)$')) or 0, domain = sh("uci -q get golden." .. sec .. ".domain") }
  end
  local mode = sh("uci -q get golden.domainfilter.mode")
  if mode == '' then mode = 'disable' end
  return {
    mode = mode,
    rules = rules,
    audit = (sh("uci -q get golden.domainfilter.audit") == '1'),
    rebindProtect = (sh("uci -q get golden.domainfilter.rebind_protect") == '1')
  }
end
local function saveDomainFilter(cfg)
  cfg = cfg or {}
  local mode = tostring(cfg.mode or 'disable')
  if mode ~= 'disable' and mode ~= 'filter' and mode ~= 'allow' then mode = 'disable' end
  local rules = cfg.rules
  if type(rules) ~= 'table' then rules = {} end
  for _, sec in ipairs(listSections('domfilter_')) do os.execute("uci -q delete golden." .. sec) end
  local n = 0
  for _, r in ipairs(rules) do
    -- 规范化：去 *、空白、首尾点（google / *.sina.* / www.qq.com → 统一为 dnsmasq 后缀匹配）
    local dom = tostring(r.domain or ''):gsub('%s+', ''):gsub('%*', '')
    dom = dom:gsub('^%.+', ''):gsub('%.+$', '')
    if dom ~= '' then
      n = n + 1
      uciSet('golden', 'domfilter_' .. n, 'domain', clean(dom))
    end
  end
  uciSet('golden', 'domainfilter', 'mode', mode)
  uciSet('golden', 'domainfilter', 'audit', (cfg.audit == true or cfg.audit == 1 or cfg.audit == '1') and '1' or '0')
  uciSet('golden', 'domainfilter', 'rebind_protect', (cfg.rebindProtect == true or cfg.rebindProtect == 1 or cfg.rebindProtect == '1') and '1' or '0')
  uciCommit('golden')
  os.execute('sh /etc/golden/domainfilter.sh restart 2>/dev/null &')
  os.execute('sh /etc/golden/dnsaudit.sh restart 2>/dev/null &')
  return { saved = n, mode = mode }
end

