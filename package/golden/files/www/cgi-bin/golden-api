    local skip = 0
    for line in f:lines() do
      skip = skip + 1
      if skip > 2 then
        -- 格式: name: rx_bytes rx_packets ... tx_bytes tx_packets ...
        local name, rx, rxp, tx, txp = line:match('^%s*([%w%.%-]+):%s+(%d+)%s+(%d+)%s+%d+%s+%d+%s+%d+%s+%d+%s+%d+%s+%d+%s+(%d+)%s+(%d+)')
