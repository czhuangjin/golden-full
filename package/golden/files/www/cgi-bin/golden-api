-- 校验 multiport 项：端口 或 起:止（如 3724-4000）
local function portItemOk(p)
  p = tostring(p or '')
  return p:match('^%d+$') ~= nil or p:match('^%d+%-%d+$') ~= nil
end
-- 应用类型列表 → 端口集合字符串（去重，multiport 上限保守取 12 项）
local function appsToPorts(apps)
  local seen, out = {}, {}
  local function add(it)
    if not portItemOk(it) then return end
    if not seen[it] then seen[it] = true; out[#out + 1] = it end
  end
  for _, name in ipairs(apps) do
    local ports = APP_PORTS[tostring(name or '')]
    if ports then
      for it in ports:gmatch('[^,]+') do add(it) end
    end
  end
  if #out > 12 then
    local tmp = {}
    for i = 1, 12 do tmp[i] = out[i] end
    out = tmp
  end
  return table.concat(out, ',')
end
-- 写入地址库文件（仅接受合法 CIDR），返回写入条数
local function writeIpLib(key, lines)
  os.execute('mkdir -p /etc/golden/iplib')
  local f = io.open('/etc/golden/iplib/' .. key .. '.txt', 'w')
  local count = 0
  if type(lines) == 'table' then
    for _, ln in ipairs(lines) do
      local cidr = tostring(ln or ''):gsub('%s+', ''):gsub('\r', '')
      if cidr:match('^%d+%.%d+%.%d+%.%d+/%d+$') then
        f:write(cidr .. '\n')
        count = count + 1
      end
    end
  end
  f:close()
  return count
end

