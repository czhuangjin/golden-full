-- ---- 安全事件中心（批5）：聚合七类安全告警为统一事件模型 ----
-- 事件源:
--   /tmp/golden_arplog          ARP 防御（时间|事件）
--   /tmp/golden_dnsblock.log    域名拦截审计（时间|IP|域名）
--   /tmp/golden_dhcpdetect.log  私接 DHCP（时间|事件）
--   logread GOLDEN-SCAN         端口扫描检测（内核 LOG，含 SRC= 源 IP）
--   logread GOLDEN-DDOS         DDoS 并发超限（内核 LOG，ddos.sh 记录）
--   logread GOLDEN-CONNLIMIT    连接限制超限（内核 LOG，connlimit.sh 记录）
--   /tmp/golden_lock/<ip>       登录爆破封禁（失败计数文件，mtime=最后失败时间）
local SEC_TYPES = {
  arp       = { name = 'ARP 防御', level = 'medium' },
  dnsblock  = { name = '域名拦截', level = 'low' },
  dhcp      = { name = '私接 DHCP', level = 'high' },
  scan      = { name = '端口扫描', level = 'high' },
  ddos      = { name = 'DDoS 攻击', level = 'critical' },
  connlimit = { name = '连接超限', level = 'medium' },
  login     = { name = '登录爆破', level = 'high' }
}
local MONTHS = { Jan = 1, Feb = 2, Mar = 3, Apr = 4, May = 5, Jun = 6, Jul = 7, Aug = 8, Sep = 9, Oct = 10, Nov = 11, Dec = 12 }
-- logread 行首时间 "Mon Aug 31 16:00:00 2026 ..." → 统一为 "2026-08-31 16:00:00"（可排序）
local function logreadTime(line)
  local mon, day, hms, year = line:match('^%S+ (%a+) (%d+) (%d+:%d+:%d+) (%d+) ')
  local m = mon and MONTHS[mon]
  if not m then return '' end
  return string.format('%04d-%02d-%02d %s', tonumber(year), m, tonumber(day), hms)
end
local function logreadSrc(line)
  return line:match('SRC=(%d+%.%d+%.%d+%.%d+)')
end
-- 读取文件末尾最多 max 行（保留最近事件，天然截断大文件）
local function tailLines(path, max)
  local out = {}
  local f = io.open(path, 'r')
  if f then
    for line in f:lines() do
      out[#out + 1] = line
      if #out > max then table.remove(out, 1) end
    end
    f:close()
  end
  return out
end
-- 从 logread 提取指定前缀的内核告警行
local function kernelEvents(prefix, max)
  return sh("logread 2>/dev/null | grep '" .. prefix .. "' | tail -" .. max)
end

local function getSecEvents(limit, typeFilter)
  limit = tonumber(limit) or 200
  if limit < 1 then limit = 1 end
  if limit > 1000 then limit = 1000 end
  typeFilter = typeFilter or ''
  local ev = {}
  local function push(time, typ, src, desc)
    local meta = SEC_TYPES[typ]
    if not meta then return end
    if typeFilter ~= '' and typ ~= typeFilter then return end
    ev[#ev + 1] = {
      time = (time and time ~= '' and time) or '-',
      type = typ, typeName = meta.name, level = meta.level,
      src = (src and src ~= '' and src) or '-', desc = desc or ''
    }
  end
  -- 1) ARP 防御事件
  for _, line in ipairs(tailLines('/tmp/golden_arplog', 300)) do
    local t, desc = line:match('^([^|]+)|(.+)$')
    if t then push(t, 'arp', desc:match('(%d+%.%d+%.%d+%.%d+)') or '', desc) end
  end
  -- 2) 域名拦截审计
  for _, line in ipairs(tailLines('/tmp/golden_dnsblock.log', 2000)) do
    local t, ip, dom = line:match('^([^|]+)|([^|]+)|(.*)$')
    if t and dom and dom ~= '' then push(t, 'dnsblock', ip, '访问被拦截域名: ' .. dom) end
  end
  -- 3) 私接 DHCP 探测
  for _, line in ipairs(tailLines('/tmp/golden_dhcpdetect.log', 500)) do
    local t, desc = line:match('^([^|]+)|(.+)$')
    if t then push(t, 'dhcp', desc:match('(%d+%.%d+%.%d+%.%d+)') or '', desc) end
  end
  -- 4) 端口扫描检测
  for line in kernelEvents('GOLDEN-SCAN', 200):gmatch('[^\n]+') do
    local dpt = line:match('DPT=(%d+)')
    push(logreadTime(line), 'scan', logreadSrc(line),
      '检测到端口扫描' .. (dpt and ('，目标端口 ' .. dpt) or '') .. '，来源已被拦截')
  end
  -- 5) DDoS 并发超限
  for line in kernelEvents('GOLDEN-DDOS', 200):gmatch('[^\n]+') do
    push(logreadTime(line), 'ddos', logreadSrc(line), '并发连接数超限，新连接已被丢弃')
  end
  -- 6) 连接限制超限
  for line in kernelEvents('GOLDEN-CONNLIMIT', 200):gmatch('[^\n]+') do
    push(logreadTime(line), 'connlimit', logreadSrc(line), '并发连接数超出限制，已重置/丢弃')
  end
  -- 7) 登录爆破封禁
  local raw = sh('ls ' .. LOCK_DIR .. ' 2>/dev/null')
  for ip in raw:gmatch('%d+%.%d+%.%d+%.%d+') do
    local n = failCount(ip)
    local mt = failTime(ip)  -- busybox 无 stat applet，改读锁文件第 2 行时间戳
    push(os.date('%Y-%m-%d %H:%M:%S', mt > 0 and mt or os.time()), 'login', ip, '登录失败 ' .. n .. ' 次，已触发 IP 封禁')
  end
  -- 按时间倒序（最新在前）
  table.sort(ev, function(a, b) return a.time > b.time end)
  local out = {}
  for i = 1, math.min(limit, #ev) do out[#out + 1] = ev[i] end
  return { events = out }
end

-- 一键封禁黑名单：UCI golden.blocklist.ip 持久化 + iptables golden_block 链执行
local function getBlockList()
  local banned, seen = {}, {}
  local raw = sh('uci -q get golden.blocklist.ip 2>/dev/null')
  for ip in raw:gmatch('%d+%.%d+%.%d+%.%d+') do
    if not seen[ip] then seen[ip] = true; banned[#banned + 1] = ip end
  end
  return { banned = banned }
end
-- block=true 封禁（建链+加规则+挂 FORWARD/INPUT，幂等）；false 解封
local function applyBlockIp(ip, block)
  if block then
    os.execute('iptables -N golden_block 2>/dev/null; '
      .. 'iptables -C golden_block -s ' .. ip .. ' -j DROP 2>/dev/null || iptables -A golden_block -s ' .. ip .. ' -j DROP 2>/dev/null; '
      .. 'iptables -C FORWARD -j golden_block 2>/dev/null || iptables -I FORWARD -j golden_block 2>/dev/null; '
      .. 'iptables -C INPUT -j golden_block 2>/dev/null || iptables -I INPUT -j golden_block 2>/dev/null')
  else
    os.execute('iptables -D golden_block -s ' .. ip .. ' -j DROP 2>/dev/null')
  end
end

-- ---- 上网行为审计（批5）：全量 DNS 查询历史 ----
-- 数据源 /tmp/golden_dnsaudit.log（时间|客户端IP|域名），dnsaudit.sh 守护写入
local function getDnsAudit(ip, limit)
  limit = tonumber(limit) or 200
  if limit < 1 then limit = 1 end
  if limit > 1000 then limit = 1000 end
  ip = ip or ''
  local out = {}
  local lines = tailLines('/tmp/golden_dnsaudit.log', 5000)
  for i = #lines, 1, -1 do
    local t, lip, dom = lines[i]:match('^([^|]+)|([^|]+)|(.*)$')
    if t and dom and dom ~= '' and (ip == '' or lip == ip) then
      out[#out + 1] = { time = t, ip = lip, domain = dom }
      if #out >= limit then break end
    end
  end
  return { logs = out }
end
local function saveDnsAudit(cfg)
  cfg = cfg or {}
  local enabled = (cfg.enabled == true or cfg.enabled == 1 or cfg.enabled == '1')
  uciSet('golden', 'dnsaudit', 'enabled', enabled and '1' or '0')
  uciCommit('golden')
  os.execute('sh /etc/golden/dnsaudit.sh restart 2>/dev/null &')
  return true
end

-- ---- 速度限制 ----
local function getSpeedLimit()
  local rules = {}
  for _, sec in ipairs(listSections('speedrule_')) do
    rules[#rules + 1] = {
      id = tonumber(sec:match('(%d+)$')) or 0,
      active = (sh("uci -q get golden." .. sec .. ".active") == '1'),
      desc = sh("uci -q get golden." .. sec .. ".desc"),
      mode = sh("uci -q get golden." .. sec .. ".mode"),
      up = tonumber(sh("uci -q get golden." .. sec .. ".up")) or 0,
      down = tonumber(sh("uci -q get golden." .. sec .. ".down")) or 0,
      wans = {},
      range = sh("uci -q get golden." .. sec .. ".range"),
      timeControl = (sh("uci -q get golden." .. sec .. ".timecontrol") == '1'),
      timeSlots = sh("uci -q get golden." .. sec .. ".timeslots")
    }
    local w = sh("uci -q get golden." .. sec .. ".wans")
    for wn in w:gmatch('[^,]+') do rules[#rules].wans[#rules[#rules].wans + 1] = wn end
  end
  return rules
end
local function saveSpeedLimit(cfg)
  local rules = cfg
  if type(rules) ~= 'table' then rules = {} end
  if rules.rules and type(rules.rules) == 'table' then rules = rules.rules end
  os.execute("uci -q delete golden.speedlimit")
  for _, sec in ipairs(listSections('speedrule_')) do os.execute("uci -q delete golden." .. sec) end
  local n, applied = 0, 0
  for _, r in ipairs(rules) do
    local active = (r.active == true or r.active == 1 or r.active == '1')
    local mode = tostring(r.mode or 'share')
    if mode ~= 'share' and mode ~= 'single' then mode = 'share' end
    local up = tonumber(r.up) or 0
    local down = tonumber(r.down) or 0
    if up < 0 then up = 0 end
    if down < 0 then down = 0 end
    local pr = parseRange(r.range or '')
    if pr.rstart ~= '' then
      local ips = nil
      if mode == 'single' then ips = expandRange(pr.rstart, pr.rend) end
      if mode ~= 'single' or ips then
        local wans = r.wans
        if type(wans) ~= 'table' or #wans == 0 then wans = { 'WAN1' } end
        for _, wn in ipairs(wans) do
          local dev = wanDev(wn)
          if dev ~= '' then
            n = n + 1
            local sec = 'speedrule_' .. n
            uciSet('golden', sec, 'active', active and '1' or '0')
            uciSet('golden', sec, 'desc', clean(r.desc or ''))
            uciSet('golden', sec, 'mode', mode)
            uciSet('golden', sec, 'dev', dev)
            uciSet('golden', sec, 'up', up)
            uciSet('golden', sec, 'down', down)
            uciSet('golden', sec, 'range', clean(r.range or ''))
            uciSet('golden', sec, 'wans', table.concat(wans, ','))
            uciSet('golden', sec, 'timecontrol', (r.timeControl == true or r.timeControl == 1 or r.timeControl == '1') and '1' or '0')
            uciSet('golden', sec, 'timeslots', clean(r.timeSlots or ''))
            if mode == 'single' then
              uciSet('golden', sec, 'ips', table.concat(ips, ','))
            else
              uciSet('golden', sec, 'rstart', pr.rstart)
              uciSet('golden', sec, 'rend', pr.rend)
            end
            if active then applied = applied + 1 end
          end
        end
      end
    end
  end
  uciSet('golden', 'speedlimit', 'enabled', applied > 0 and '1' or '0')
  uciCommit('golden')
  os.execute('sh /etc/golden/speedlimit.sh restart 2>/dev/null &')
  return { saved = n, applied = applied }
end

