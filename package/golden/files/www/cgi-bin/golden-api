local function getAccess()
  local info = { httpPort = 80, remoteAccess = false, remotePort = 8080, adminUser = 'root', guestUser = 'guest', loginLock = 5, sessionTimeout = 15 }
  local listen = sh("uci get uhttpd.main.listen_http 2>/dev/null")
